<?xml version='1.0' encoding='utf-8'?>
<Patch>
  <!---->
  <!-- Gorilla -->
  <!-- Gorilla StatBases -->
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "Gorilla"]/statBases/MarketValue</xpath>
    <value>
      <MarketValue>625</MarketValue>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "Gorilla"]/statBases/MoveSpeed</xpath>
    <value>
      <MoveSpeed>4</MoveSpeed>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "Gorilla"]/statBases/Wildness</xpath>
    <value>
      <Wildness>0.9</Wildness>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "Gorilla"]/statBases/FilthRate</xpath>
    <value>
      <FilthRate>2</FilthRate>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "Gorilla"]/statBases/ComfyTemperatureMin</xpath>
    <value>
      <ComfyTemperatureMin>-5</ComfyTemperatureMin>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "Gorilla"]/statBases/ComfyTemperatureMax</xpath>
    <value>
      <ComfyTemperatureMax>40</ComfyTemperatureMax>
    </value>
  </Operation>
  <!-- Gorilla tools -->
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "Gorilla"]/tools</xpath>
    <value>
      <tools>
        <li>
          <label>head</label>
          <capacities>
            <li>Blunt</li>
          </capacities>
          <power>9.5</power>
          <cooldownTime>2.3</cooldownTime>
          <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
          <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
          <chanceFactor>0.2</chanceFactor>
        </li>
        <li>
          <label>left fist</label>
          <labelNoLocation>fist</labelNoLocation>
          <capacities>
            <li>Blunt</li>
          </capacities>
          <power>12.5</power>
          <cooldownTime>1.5</cooldownTime>
          <linkedBodyPartsGroup>LeftHand</linkedBodyPartsGroup>
        </li>
        <li>
          <label>right fist</label>
          <labelNoLocation>fist</labelNoLocation>
          <capacities>
            <li>Blunt</li>
          </capacities>
          <power>12.5</power>
          <cooldownTime>1.5</cooldownTime>
          <linkedBodyPartsGroup>RightHand</linkedBodyPartsGroup>
        </li>
        <li>
          <label>canines</label>
          <capacities>
            <li>Bite</li>
          </capacities>
          <power>14.5</power>
          <cooldownTime>1.95</cooldownTime>
          <linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
        </li>
      </tools>
    </value>
  </Operation>
  <!-- Gorilla RaceProperties -->
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "Gorilla"]/race/baseBodySize</xpath>
    <value>
      <baseBodySize>1.5</baseBodySize>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "Gorilla"]/race/baseHealthScale</xpath>
    <value>
      <baseHealthScale>1.5</baseHealthScale>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "Gorilla"]/race/baseHungerRate</xpath>
    <value>
      <baseHungerRate>0.75</baseHungerRate>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "Gorilla"]/race/lifeExpectancy</xpath>
    <value>
      <lifeExpectancy>50</lifeExpectancy>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "Gorilla"]/race/gestationPeriodDays</xpath>
    <value>
      <gestationPeriodDays>11</gestationPeriodDays>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThingDef[defName = "Gorilla"]/race</xpath>
    <value>
      <herdAnimal>true</herdAnimal>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThingDef[defName = "Gorilla"]/race</xpath>
    <value>
      <herdMigrationAllowed>false</herdMigrationAllowed>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "Gorilla"]/race/foodType</xpath>
    <value>
      <foodType>VegetarianRoughAnimal</foodType>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "Gorilla"]/race/manhunterOnTameFailChance</xpath>
    <value>
      <manhunterOnTameFailChance>0.025</manhunterOnTameFailChance>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "Gorilla"]/race/manhunterOnDamageChance</xpath>
    <value>
      <manhunterOnDamageChance>0.1</manhunterOnDamageChance>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThingDef[defName = "Gorilla"]/race</xpath>
    <value>
      <nameOnTameChance>1</nameOnTameChance>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "Gorilla"]/race/body</xpath>
    <value>
      <body>Ape</body>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThingDef[defName = "Gorilla"]/race</xpath>
    <value>
      <useMeatFrom>Monkey</useMeatFrom>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "Gorilla"]/race/lifeStageAges</xpath>
    <value>
      <lifeStageAges>
        <li>
          <def>AnimalBaby</def>
          <minAge>0</minAge>
        </li>
        <li>
          <def>AnimalJuvenile</def>
          <minAge>0.6</minAge>
        </li>
        <li>
          <def>AnimalAdult</def>
          <minAge>1.2</minAge>
          <soundWounded>Pawn_Gorilla_Wounded</soundWounded>
          <soundDeath>Pawn_Gorilla_Death</soundDeath>
          <soundCall>Pawn_Gorilla_Call</soundCall>
          <soundAngry>Pawn_Gorilla_Angry</soundAngry>
        </li>
      </lifeStageAges>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "Gorilla"]/race/specialTrainables/li[text()='Forage']</xpath>
    <value>
      <li MayRequire="Ludeon.RimWorld.Odyssey">Forage</li>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThingDef[defName = "Gorilla"]/tradeTags</xpath>
    <value>
      <li>AnimalFighter</li>
    </value>
  </Operation>
  <Operation Class="PatchOperationAddModExtension">
    <xpath>/Defs/ThingDef[defName = "Gorilla"]</xpath>
    <value>
      <li Class="ZoologyMod.ModExtension_IsMammal, ZoologyMod"/>
    </value>
  </Operation>
  <Operation Class="PatchOperationAddModExtension">
    <xpath>/Defs/ThingDef[defName = "Gorilla"]</xpath>
    <value>
      <li Class="ZoologyMod.ModExtensiom_Chlidcare, ZoologyMod"/>
    </value>
  </Operation>
  <!-- Gorilla PawnKindDef -->
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/PawnKindDef[defName = "Gorilla"]/combatPower</xpath>
    <value>
      <combatPower>125</combatPower>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/PawnKindDef[defName = "Gorilla"]/ecoSystemWeight</xpath>
    <value>
      <ecoSystemWeight>0.9</ecoSystemWeight>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/PawnKindDef[defName = "Gorilla"]</xpath>
    <value>
      <canArriveManhunter>false</canArriveManhunter>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/PawnKindDef[defName = "Gorilla"]</xpath>
    <value>
      <wildGroupSize>3~10</wildGroupSize>
    </value>
  </Operation>
  <!-- Combat Extended specific patches -->
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Combat Extended</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
        <!-- Gorilla CE patches -->
        <li Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="Gorilla"]/statBases</xpath>
          <value>
            <MeleeDodgeChance>0.45</MeleeDodgeChance>
          </value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="Gorilla"]/statBases</xpath>
          <value>
            <MeleeCritChance>0.25</MeleeCritChance>
          </value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="Gorilla"]/statBases</xpath>
          <value>
            <MeleeParryChance>0.1</MeleeParryChance>
          </value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="Gorilla"]/statBases</xpath>
          <value>
            <ArmorRating_Sharp>0.08</ArmorRating_Sharp>
          </value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="Gorilla"]/statBases</xpath>
          <value>
            <ArmorRating_Blunt>0.3</ArmorRating_Blunt>
          </value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="Gorilla"]</xpath>
          <value>
            <comps/>
          </value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="Gorilla"]/comps</xpath>
          <value>
            <li Class="CombatExtended.CompProperties_ArmorDurability">
              <Durability>750</Durability>
              <Regenerates>true</Regenerates>
              <RegenInterval>600</RegenInterval>
              <RegenValue>5</RegenValue>
              <MinArmorPct>0.5</MinArmorPct>
            </li>
          </value>
        </li>
        <li Class="PatchOperationAddModExtension">
          <xpath>Defs/ThingDef[defName="Gorilla"]</xpath>
          <value>
            <li Class="CombatExtended.RacePropertiesExtensionCE">
              <bodyShape>HumanoidWide</bodyShape>
            </li>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>/Defs/ThingDef[defName="Gorilla"]/tools</xpath>
          <value>
            <tools>
              <li Class="CombatExtended.ToolCE">
                <label>head</label>
                <capacities>
                  <li>Blunt</li>
                </capacities>
                <power>4.3</power>
                <armorPenetrationBlunt>3.75</armorPenetrationBlunt>
                <cooldownTime>1.75</cooldownTime>
                <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
                <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
                <chanceFactor>0.2</chanceFactor>
              </li>
              <li Class="CombatExtended.ToolCE">
                <label>left fist</label>
                <labelNoLocation>fist</labelNoLocation>
                <capacities>
                  <li>Blunt</li>
                </capacities>
                <power>9.2</power>
                <armorPenetrationBlunt>4.65</armorPenetrationBlunt>
                <cooldownTime>1.45</cooldownTime>
                <linkedBodyPartsGroup>LeftHand</linkedBodyPartsGroup>
              </li>
              <li Class="CombatExtended.ToolCE">
                <label>right fist</label>
                <labelNoLocation>fist</labelNoLocation>
                <capacities>
                  <li>Blunt</li>
                </capacities>
                <power>9.2</power>
                <armorPenetrationBlunt>4.65</armorPenetrationBlunt>
                <cooldownTime>1.45</cooldownTime>
                <linkedBodyPartsGroup>RightHand</linkedBodyPartsGroup>
              </li>
              <li Class="CombatExtended.ToolCE">
                <label>canines</label>
                <capacities>
                  <li>Bite</li>
                </capacities>
                <power>11.5</power>
                <armorPenetrationBlunt>2.85</armorPenetrationBlunt>
                <armorPenetrationSharp>0.13</armorPenetrationSharp>
                <cooldownTime>2.1</cooldownTime>
                <linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
              </li>
            </tools>
          </value>
        </li>
      </operations>
    </match>
  </Operation>
</Patch>
