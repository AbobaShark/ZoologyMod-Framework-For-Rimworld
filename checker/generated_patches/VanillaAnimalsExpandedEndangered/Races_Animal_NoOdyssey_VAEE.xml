<?xml version='1.0' encoding='utf-8'?>
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Odyssey</li>
    </mods>
    <nomatch Class="PatchOperationSequence">
      <operations>
        <!---->
        <!-- AEXP_Panda -->
        <!-- AEXP_Panda StatBases -->
        <li Class="PatchOperationReplace">
          <xpath>/Defs/ThingDef[defName = "AEXP_Panda"]/statBases/MarketValue</xpath>
          <value>
            <MarketValue>600</MarketValue>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>/Defs/ThingDef[defName = "AEXP_Panda"]/statBases/MoveSpeed</xpath>
          <value>
            <MoveSpeed>5</MoveSpeed>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>/Defs/ThingDef[defName = "AEXP_Panda"]/statBases/Wildness</xpath>
          <value>
            <Wildness>0.7</Wildness>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>/Defs/ThingDef[defName = "AEXP_Panda"]/statBases/FilthRate</xpath>
          <value>
            <FilthRate>2</FilthRate>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>/Defs/ThingDef[defName = "AEXP_Panda"]/statBases/ComfyTemperatureMin</xpath>
          <value>
            <ComfyTemperatureMin>-35</ComfyTemperatureMin>
          </value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>/Defs/ThingDef[defName = "AEXP_Panda"]/statBases</xpath>
          <value>
            <ComfyTemperatureMax>35</ComfyTemperatureMax>
          </value>
        </li>
        <!-- AEXP_Panda tools -->
        <li Class="PatchOperationReplace">
          <xpath>/Defs/ThingDef[defName = "AEXP_Panda"]/tools</xpath>
          <value>
            <tools>
              <li>
                <label>head</label>
                <capacities>
                  <li>Blunt</li>
                </capacities>
                <power>9</power>
                <cooldownTime>2.2</cooldownTime>
                <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
                <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
                <chanceFactor>0.2</chanceFactor>
              </li>
              <li>
                <label>left claw</label>
                <labelNoLocation>claw</labelNoLocation>
                <capacities>
                  <li>Scratch</li>
                </capacities>
                <power>13.5</power>
                <cooldownTime>1.45</cooldownTime>
                <linkedBodyPartsGroup>FrontLeftPaw</linkedBodyPartsGroup>
              </li>
              <li>
                <label>right claw</label>
                <labelNoLocation>claw</labelNoLocation>
                <capacities>
                  <li>Scratch</li>
                </capacities>
                <power>13.5</power>
                <cooldownTime>1.45</cooldownTime>
                <linkedBodyPartsGroup>FrontRightPaw</linkedBodyPartsGroup>
              </li>
              <li>
                <label>canines</label>
                <capacities>
                  <li>Bite</li>
                </capacities>
                <power>15.5</power>
                <cooldownTime>1.85</cooldownTime>
                <linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
              </li>
            </tools>
          </value>
        </li>
        <!-- AEXP_Panda RaceProperties -->
        <li Class="PatchOperationReplace">
          <xpath>/Defs/ThingDef[defName = "AEXP_Panda"]/race/baseBodySize</xpath>
          <value>
            <baseBodySize>1.3</baseBodySize>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>/Defs/ThingDef[defName = "AEXP_Panda"]/race/baseHealthScale</xpath>
          <value>
            <baseHealthScale>1.55</baseHealthScale>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>/Defs/ThingDef[defName = "AEXP_Panda"]/race/baseHungerRate</xpath>
          <value>
            <baseHungerRate>0.65</baseHungerRate>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>/Defs/ThingDef[defName = "AEXP_Panda"]/race/gestationPeriodDays</xpath>
          <value>
            <gestationPeriodDays>6</gestationPeriodDays>
          </value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>/Defs/ThingDef[defName = "AEXP_Panda"]/race</xpath>
          <value>
            <herdMigrationAllowed>false</herdMigrationAllowed>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>/Defs/ThingDef[defName = "AEXP_Panda"]/race/manhunterOnTameFailChance</xpath>
          <value>
            <manhunterOnTameFailChance>0.025</manhunterOnTameFailChance>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>/Defs/ThingDef[defName = "AEXP_Panda"]/race/manhunterOnDamageChance</xpath>
          <value>
            <manhunterOnDamageChance>0.1</manhunterOnDamageChance>
          </value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>/Defs/ThingDef[defName = "AEXP_Panda"]/race</xpath>
          <value>
            <nameOnTameChance>1</nameOnTameChance>
          </value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>/Defs/ThingDef[defName = "AEXP_Panda"]/race</xpath>
          <value>
            <wildBiomes>
              <TemperateForest>0.019</TemperateForest>
              <TemperateSwamp>0.019</TemperateSwamp>
            </wildBiomes>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>/Defs/ThingDef[defName = "AEXP_Panda"]/race/lifeStageAges</xpath>
          <value>
            <lifeStageAges>
              <li>
                <def>AnimalBaby</def>
                <minAge>0</minAge>
              </li>
              <li>
                <def>AnimalJuvenile</def>
                <minAge>0.5</minAge>
              </li>
              <li>
                <def>AnimalAdult</def>
                <minAge>1</minAge>
                <soundWounded>Pawn_Bear_Injured</soundWounded>
                <soundDeath>Pawn_Bear_Death</soundDeath>
                <soundCall>Pawn_Bear_Call</soundCall>
                <soundAngry>Pawn_Bear_Angry</soundAngry>
              </li>
            </lifeStageAges>
          </value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>/Defs/ThingDef[defName = "AEXP_Panda"]/race</xpath>
          <value>
            <litterSizeCurve>
              <points>
                <li>(0.3000, 0)</li>
                <li>(0.6000, 0.2)</li>
                <li>(1.2000, 1)</li>
                <li>(1.8000, 1)</li>
                <li>(2.4000, 0.2)</li>
                <li>(2.7000, 0)</li>
              </points>
            </litterSizeCurve>
          </value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>/Defs/ThingDef[defName = "AEXP_Panda"]/tradeTags</xpath>
          <value>
            <li>AnimalUncommon</li>
            <li>AnimalFighter</li>
          </value>
        </li>
        <li Class="PatchOperationAddModExtension">
          <xpath>/Defs/ThingDef[defName = "AEXP_Panda"]</xpath>
          <value>
            <li Class="ZoologyMod.ModExtension_IsMammal, ZoologyMod"/>
          </value>
        </li>
        <li Class="PatchOperationAddModExtension">
          <xpath>/Defs/ThingDef[defName = "AEXP_Panda"]</xpath>
          <value>
            <li Class="ZoologyMod.ModExtensiom_Chlidcare, ZoologyMod"/>
          </value>
        </li>
        <!-- AEXP_Panda PawnKindDef -->
        <li Class="PatchOperationReplace">
          <xpath>/Defs/PawnKindDef[defName = "AEXP_Panda"]/combatPower</xpath>
          <value>
            <combatPower>140</combatPower>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>/Defs/PawnKindDef[defName = "AEXP_Panda"]/ecoSystemWeight</xpath>
          <value>
            <ecoSystemWeight>0.8</ecoSystemWeight>
          </value>
        </li>
      </operations>
    </nomatch>
  </Operation>
  <!---->
  <!-- Combat Extended specific patches -->
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Combat Extended</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationFindMod">
          <mods>
            <li>Odyssey</li>
          </mods>
          <nomatch Class="PatchOperationSequence">
            <operations>
              <!-- AEXP_Panda CE patches -->
              <li Class="PatchOperationAdd">
                <xpath>Defs/ThingDef[defName="AEXP_Panda"]/statBases</xpath>
                <value>
                  <MeleeDodgeChance>0.3</MeleeDodgeChance>
                </value>
              </li>
              <li Class="PatchOperationAdd">
                <xpath>Defs/ThingDef[defName="AEXP_Panda"]/statBases</xpath>
                <value>
                  <MeleeCritChance>0.35</MeleeCritChance>
                </value>
              </li>
              <li Class="PatchOperationAdd">
                <xpath>Defs/ThingDef[defName="AEXP_Panda"]/statBases</xpath>
                <value>
                  <MeleeParryChance>0.05</MeleeParryChance>
                </value>
              </li>
              <li Class="PatchOperationAdd">
                <xpath>Defs/ThingDef[defName="AEXP_Panda"]/statBases</xpath>
                <value>
                  <ArmorRating_Sharp>0.11</ArmorRating_Sharp>
                </value>
              </li>
              <li Class="PatchOperationAdd">
                <xpath>Defs/ThingDef[defName="AEXP_Panda"]/statBases</xpath>
                <value>
                  <ArmorRating_Blunt>0.45</ArmorRating_Blunt>
                </value>
              </li>
              <li Class="PatchOperationAdd">
                <xpath>Defs/ThingDef[defName="AEXP_Panda"]</xpath>
                <value>
                  <comps/>
                </value>
              </li>
              <li Class="PatchOperationAdd">
                <xpath>Defs/ThingDef[defName="AEXP_Panda"]/comps</xpath>
                <value>
                  <li Class="CombatExtended.CompProperties_ArmorDurability">
                    <Durability>725</Durability>
                    <Regenerates>true</Regenerates>
                    <RegenInterval>600</RegenInterval>
                    <RegenValue>5</RegenValue>
                    <MinArmorPct>0.5</MinArmorPct>
                  </li>
                </value>
              </li>
              <li Class="PatchOperationAddModExtension">
                <xpath>Defs/ThingDef[defName="AEXP_Panda"]</xpath>
                <value>
                  <li Class="CombatExtended.RacePropertiesExtensionCE">
                    <bodyShape>Quadruped</bodyShape>
                  </li>
                </value>
              </li>
              <li Class="PatchOperationReplace">
                <xpath>/Defs/ThingDef[defName="AEXP_Panda"]/tools</xpath>
                <value>
                  <tools>
                    <li Class="CombatExtended.ToolCE">
                      <label>head</label>
                      <capacities>
                        <li>Blunt</li>
                      </capacities>
                      <power>3.5</power>
                      <armorPenetrationBlunt>3</armorPenetrationBlunt>
                      <cooldownTime>1.65</cooldownTime>
                      <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
                      <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
                      <chanceFactor>0.2</chanceFactor>
                    </li>
                    <li Class="CombatExtended.ToolCE">
                      <label>left claw</label>
                      <labelNoLocation>claw</labelNoLocation>
                      <capacities>
                        <li>Scratch</li>
                      </capacities>
                      <power>14.5</power>
                      <armorPenetrationBlunt>3.8</armorPenetrationBlunt>
                      <armorPenetrationSharp>0.19</armorPenetrationSharp>
                      <cooldownTime>1.5</cooldownTime>
                      <linkedBodyPartsGroup>FrontLeftPaw</linkedBodyPartsGroup>
                    </li>
                    <li Class="CombatExtended.ToolCE">
                      <label>right claw</label>
                      <labelNoLocation>claw</labelNoLocation>
                      <capacities>
                        <li>Scratch</li>
                      </capacities>
                      <power>14.5</power>
                      <armorPenetrationBlunt>3.8</armorPenetrationBlunt>
                      <armorPenetrationSharp>0.19</armorPenetrationSharp>
                      <cooldownTime>1.5</cooldownTime>
                      <linkedBodyPartsGroup>FrontRightPaw</linkedBodyPartsGroup>
                    </li>
                    <li Class="CombatExtended.ToolCE">
                      <label>canines</label>
                      <capacities>
                        <li>Bite</li>
                      </capacities>
                      <power>17</power>
                      <armorPenetrationBlunt>5.75</armorPenetrationBlunt>
                      <armorPenetrationSharp>0.29</armorPenetrationSharp>
                      <cooldownTime>2.2</cooldownTime>
                      <linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
                    </li>
                  </tools>
                </value>
              </li>
            </operations>
          </nomatch>
        </li>
      </operations>
    </match>
  </Operation>
</Patch>
