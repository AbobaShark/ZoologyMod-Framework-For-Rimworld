<?xml version='1.0' encoding='utf-8'?>
<Patch>
  <!---->
  <!-- WasteRat -->
  <Operation Class="PatchOperationAttributeSet">
    <xpath>/Defs/ThingDef[defName = "WasteRat"]</xpath>
    <attribute>ParentName</attribute>
    <value>AnimalThingBase</value>
  </Operation>
  <Operation Class="PatchOperationAttributeSet">
    <xpath>/Defs/PawnKindDef[defName = "WasteRat"]</xpath>
    <attribute>ParentName</attribute>
    <value>AnimalKindBase</value>
  </Operation>
  <!-- WasteRat StatBases -->
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThingDef[defName = "WasteRat"]/statBases</xpath>
    <value>
      <MarketValue>150</MarketValue>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThingDef[defName = "WasteRat"]/statBases</xpath>
    <value>
      <MoveSpeed>3.5</MoveSpeed>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThingDef[defName = "WasteRat"]/statBases</xpath>
    <value>
      <Wildness>0.6</Wildness>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "WasteRat"]/statBases/FilthRate</xpath>
    <value>
      <FilthRate>1</FilthRate>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "WasteRat"]/statBases/ComfyTemperatureMin</xpath>
    <value>
      <ComfyTemperatureMin>-35</ComfyTemperatureMin>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThingDef[defName = "WasteRat"]/statBases</xpath>
    <value>
      <ComfyTemperatureMax>50</ComfyTemperatureMax>
    </value>
  </Operation>
  <!-- WasteRat tools -->
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "WasteRat"]/tools</xpath>
    <value>
      <tools Inherit="False">
        <li>
          <label>head</label>
          <capacities>
            <li>Blunt</li>
          </capacities>
          <power>3.5</power>
          <cooldownTime>1.45</cooldownTime>
          <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
          <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
          <chanceFactor>0.2</chanceFactor>
        </li>
        <li>
          <label>Incisors</label>
          <capacities>
            <li>Bite</li>
          </capacities>
          <power>7.5</power>
          <cooldownTime>1.3</cooldownTime>
          <linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
        </li>
      </tools>
    </value>
  </Operation>
  <!-- WasteRat RaceProperties -->
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "WasteRat"]/race/baseBodySize</xpath>
    <value>
      <baseBodySize>0.4</baseBodySize>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThingDef[defName = "WasteRat"]/race</xpath>
    <value>
      <baseHealthScale>0.4</baseHealthScale>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThingDef[defName = "WasteRat"]/race</xpath>
    <value>
      <baseHungerRate>0.35</baseHungerRate>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThingDef[defName = "WasteRat"]/race</xpath>
    <value>
      <gestationPeriodDays>7</gestationPeriodDays>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThingDef[defName = "WasteRat"]/race</xpath>
    <value>
      <herdAnimal>true</herdAnimal>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThingDef[defName = "WasteRat"]/race</xpath>
    <value>
      <herdMigrationAllowed>false</herdMigrationAllowed>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThingDef[defName = "WasteRat"]/race</xpath>
    <value>
      <foodType>OmnivoreAnimal, OvivoreAnimal</foodType>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThingDef[defName = "WasteRat"]/race</xpath>
    <value>
      <leatherDef>VAEWaste_ToxicLeather</leatherDef>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "WasteRat"]/race/manhunterOnTameFailChance</xpath>
    <value>
      <manhunterOnTameFailChance>0.1</manhunterOnTameFailChance>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "WasteRat"]/race/manhunterOnDamageChance</xpath>
    <value>
      <manhunterOnDamageChance>0.3</manhunterOnDamageChance>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThingDef[defName = "WasteRat"]/race</xpath>
    <value>
      <nuzzleMtbHours>36</nuzzleMtbHours>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThingDef[defName = "WasteRat"]/race</xpath>
    <value>
      <nameOnTameChance>1</nameOnTameChance>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThingDef[defName = "WasteRat"]/race</xpath>
    <value>
      <body>QuadrupedAnimalWithPawsAndTail</body>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThingDef[defName = "WasteRat"]/race</xpath>
    <value>
      <lifeStageAges Inherit="False">
        <li>
          <def>AnimalBaby</def>
          <minAge>0</minAge>
        </li>
        <li>
          <def>AnimalJuvenile</def>
          <minAge>0.15</minAge>
        </li>
        <li>
          <def>AnimalAdult</def>
          <minAge>0.3</minAge>
          <soundWounded>Pawn_Boomrat_Wounded</soundWounded>
          <soundDeath>Pawn_Boomrat_Death</soundDeath>
          <soundCall>Pawn_Boomrat_Call</soundCall>
          <soundAngry>Pawn_Boomrat_Angry</soundAngry>
        </li>
      </lifeStageAges>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThingDef[defName = "WasteRat"]/race</xpath>
    <value>
      <litterSizeCurve Inherit="False">
        <points>
          <li>(1.6000, 0)</li>
          <li>(3.2000, 0.2)</li>
          <li>(6.4000, 1)</li>
          <li>(9.6000, 1)</li>
          <li>(12.8000, 0.2)</li>
          <li>(14.4000, 0)</li>
        </points>
      </litterSizeCurve>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThingDef[defName = "WasteRat"]/race</xpath>
    <value>
      <specialTrainables>
        <li MayRequire="Ludeon.RimWorld.Odyssey">Forage</li>
        <li MayRequire="Ludeon.RimWorld.Odyssey">Comfort</li>
      </specialTrainables>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThingDef[defName = "WasteRat"]</xpath>
    <value>
      <tradeTags Inherit="False">
        <li>AnimalCommon</li>
      </tradeTags>
    </value>
  </Operation>
  <Operation Class="PatchOperationAddModExtension">
    <xpath>/Defs/ThingDef[defName = "WasteRat"]</xpath>
    <value>
      <li Class="ZoologyMod.ModExtension_IsMammal, ZoologyMod"/>
    </value>
  </Operation>
  <Operation Class="PatchOperationAddModExtension">
    <xpath>/Defs/ThingDef[defName = "WasteRat"]</xpath>
    <value>
      <li Class="ZoologyMod.ModExtensiom_Chlidcare, ZoologyMod"/>
    </value>
  </Operation>
  <Operation Class="PatchOperationAddModExtension">
    <xpath>/Defs/ThingDef[defName = "WasteRat"]</xpath>
    <value>
      <li Class="ZoologyMod.ModExtension_IsScavenger, ZoologyMod">
        <allowVeryRotten>true</allowVeryRotten>
      </li>
    </value>
  </Operation>
  <!-- WasteRat PawnKindDef -->
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/PawnKindDef[defName = "WasteRat"]/combatPower</xpath>
    <value>
      <combatPower>50</combatPower>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/PawnKindDef[defName = "WasteRat"]/ecoSystemWeight</xpath>
    <value>
      <ecoSystemWeight>0.35</ecoSystemWeight>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/PawnKindDef[defName = "WasteRat"]</xpath>
    <value>
      <wildGroupSize>1~6</wildGroupSize>
    </value>
  </Operation>
  <!-- Combat Extended specific patches -->
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Combat Extended</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
        <!-- WasteRat CE patches -->
        <li Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="WasteRat"]/statBases</xpath>
          <value>
            <MeleeDodgeChance>0.5</MeleeDodgeChance>
          </value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="WasteRat"]/statBases</xpath>
          <value>
            <MeleeCritChance>0.15</MeleeCritChance>
          </value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="WasteRat"]/statBases</xpath>
          <value>
            <MeleeParryChance>0.05</MeleeParryChance>
          </value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="WasteRat"]/statBases</xpath>
          <value>
            <ArmorRating_Sharp>0.03</ArmorRating_Sharp>
          </value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="WasteRat"]/statBases</xpath>
          <value>
            <ArmorRating_Blunt>0.15</ArmorRating_Blunt>
          </value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="WasteRat"]</xpath>
          <value>
            <comps/>
          </value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="WasteRat"]/comps</xpath>
          <value>
            <li Class="CombatExtended.CompProperties_ArmorDurability">
              <Durability>200</Durability>
              <Regenerates>true</Regenerates>
              <RegenInterval>600</RegenInterval>
              <RegenValue>5</RegenValue>
              <MinArmorPct>0.5</MinArmorPct>
            </li>
          </value>
        </li>
        <li Class="PatchOperationAddModExtension">
          <xpath>Defs/ThingDef[defName="WasteRat"]</xpath>
          <value>
            <li Class="CombatExtended.RacePropertiesExtensionCE">
              <bodyShape>QuadrupedLow</bodyShape>
            </li>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>/Defs/ThingDef[defName="WasteRat"]/tools</xpath>
          <value>
            <tools Inherit="False">
              <li Class="CombatExtended.ToolCE">
                <label>head</label>
                <capacities>
                  <li>Blunt</li>
                </capacities>
                <power>0.4</power>
                <armorPenetrationBlunt>0.35</armorPenetrationBlunt>
                <cooldownTime>1.6</cooldownTime>
                <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
                <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
                <chanceFactor>0.2</chanceFactor>
              </li>
              <li Class="CombatExtended.ToolCE">
                <label>Incisors</label>
                <capacities>
                  <li>Bite</li>
                </capacities>
                <power>4.8</power>
                <armorPenetrationBlunt>0.35</armorPenetrationBlunt>
                <armorPenetrationSharp>0.05</armorPenetrationSharp>
                <cooldownTime>2.1</cooldownTime>
                <linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
              </li>
            </tools>
          </value>
        </li>
      </operations>
    </match>
  </Operation>
</Patch>
