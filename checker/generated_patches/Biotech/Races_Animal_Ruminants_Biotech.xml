<?xml version='1.0' encoding='utf-8'?>
<Patch>
  <!---->
  <!-- Toxalope -->
  <Operation Class="PatchOperationAttributeSet">
    <xpath>/Defs/ThingDef[defName = "Toxalope"]</xpath>
    <attribute>ParentName</attribute>
    <value>AnimalThingBase</value>
  </Operation>
  <Operation Class="PatchOperationAttributeSet">
    <xpath>/Defs/PawnKindDef[defName = "Toxalope"]</xpath>
    <attribute>ParentName</attribute>
    <value>AnimalKindBase</value>
  </Operation>
  <!-- Toxalope StatBases -->
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThingDef[defName = "Toxalope"]/statBases</xpath>
    <value>
      <MarketValue>250</MarketValue>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThingDef[defName = "Toxalope"]/statBases</xpath>
    <value>
      <MoveSpeed>4</MoveSpeed>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThingDef[defName = "Toxalope"]/statBases</xpath>
    <value>
      <Wildness>0.5</Wildness>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "Toxalope"]/statBases/FilthRate</xpath>
    <value>
      <FilthRate>8</FilthRate>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThingDef[defName = "Toxalope"]/statBases</xpath>
    <value>
      <ComfyTemperatureMin>-45</ComfyTemperatureMin>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThingDef[defName = "Toxalope"]/statBases</xpath>
    <value>
      <ComfyTemperatureMax>50</ComfyTemperatureMax>
    </value>
  </Operation>
  <!-- Toxalope tools -->
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThingDef[defName = "Toxalope"]</xpath>
    <value>
      <tools Inherit="False">
        <li>
          <label>head</label>
          <capacities>
            <li>Blunt</li>
          </capacities>
          <power>9.5</power>
          <cooldownTime>2.3</cooldownTime>
          <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
          <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
          <chanceFactor>0.2</chanceFactor>
        </li>
        <li>
          <label>left hoof</label>
          <labelNoLocation>hoof</labelNoLocation>
          <capacities>
            <li>Blunt</li>
          </capacities>
          <power>12</power>
          <cooldownTime>2.15</cooldownTime>
          <linkedBodyPartsGroup>FrontLeftLeg</linkedBodyPartsGroup>
        </li>
        <li>
          <label>right hoof</label>
          <labelNoLocation>hoof</labelNoLocation>
          <capacities>
            <li>Blunt</li>
          </capacities>
          <power>12</power>
          <cooldownTime>2.15</cooldownTime>
          <linkedBodyPartsGroup>FrontRightLeg</linkedBodyPartsGroup>
        </li>
        <li>
          <label>teeth</label>
          <capacities>
            <li>Bite</li>
          </capacities>
          <power>12</power>
          <cooldownTime>2.3</cooldownTime>
          <linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
        </li>
      </tools>
    </value>
  </Operation>
  <!-- Toxalope RaceProperties -->
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "Toxalope"]/race/baseBodySize</xpath>
    <value>
      <baseBodySize>1.5</baseBodySize>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThingDef[defName = "Toxalope"]/race</xpath>
    <value>
      <baseHealthScale>1.5</baseHealthScale>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThingDef[defName = "Toxalope"]/race</xpath>
    <value>
      <baseHungerRate>0.75</baseHungerRate>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "Toxalope"]/race/lifeExpectancy</xpath>
    <value>
      <lifeExpectancy>12</lifeExpectancy>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThingDef[defName = "Toxalope"]/race</xpath>
    <value>
      <gestationPeriodDays>9.5</gestationPeriodDays>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThingDef[defName = "Toxalope"]/race</xpath>
    <value>
      <herdAnimal>true</herdAnimal>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThingDef[defName = "Toxalope"]/race</xpath>
    <value>
      <foodType>VegetarianRoughAnimal</foodType>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThingDef[defName = "Toxalope"]/race</xpath>
    <value>
      <roamMtbDays>4</roamMtbDays>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThingDef[defName = "Toxalope"]/race</xpath>
    <value>
      <leatherDef>VAEWaste_ToxicLeather</leatherDef>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThingDef[defName = "Toxalope"]/race</xpath>
    <value>
      <manhunterOnTameFailChance>0.1</manhunterOnTameFailChance>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThingDef[defName = "Toxalope"]/race</xpath>
    <value>
      <manhunterOnDamageChance>0.3</manhunterOnDamageChance>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThingDef[defName = "Toxalope"]/race</xpath>
    <value>
      <body>QuadrupedAnimalWithHoovesAndHump</body>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThingDef[defName = "Toxalope"]/race</xpath>
    <value>
      <lifeStageAges Inherit="False">
        <li>
          <def>AnimalBaby</def>
          <minAge>0</minAge>
        </li>
        <li>
          <def>AnimalJuvenile</def>
          <minAge>0.2</minAge>
        </li>
        <li>
          <def>AnimalAdult</def>
          <minAge>0.4</minAge>
          <soundWounded>Pawn_Muffalo_Wounded</soundWounded>
          <soundDeath>Pawn_Muffalo_Death</soundDeath>
          <soundCall>Pawn_Muffalo_Call</soundCall>
          <soundAngry>Pawn_Muffalo_Angry</soundAngry>
        </li>
      </lifeStageAges>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThingDef[defName = "Toxalope"]/tradeTags</xpath>
    <value>
      <li>AnimalCommon</li>
    </value>
  </Operation>
  <Operation Class="PatchOperationAddModExtension">
    <xpath>/Defs/ThingDef[defName = "Toxalope"]</xpath>
    <value>
      <li Class="ZoologyMod.ModExtension_IsMammal, ZoologyMod"/>
    </value>
  </Operation>
  <Operation Class="PatchOperationAddModExtension">
    <xpath>/Defs/ThingDef[defName = "Toxalope"]</xpath>
    <value>
      <li Class="ZoologyMod.ModExtensiom_Chlidcare, ZoologyMod"/>
    </value>
  </Operation>
  <!-- Toxalope PawnKindDef -->
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/PawnKindDef[defName = "Toxalope"]/combatPower</xpath>
    <value>
      <combatPower>145</combatPower>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/PawnKindDef[defName = "Toxalope"]</xpath>
    <value>
      <ecoSystemWeight>0.9</ecoSystemWeight>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/PawnKindDef[defName = "Toxalope"]</xpath>
    <value>
      <wildGroupSize>2~6</wildGroupSize>
    </value>
  </Operation>
  <!-- Combat Extended specific patches -->
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Combat Extended</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
        <!-- Toxalope CE patches -->
        <li Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="Toxalope"]/statBases</xpath>
          <value>
            <MeleeDodgeChance>0.2</MeleeDodgeChance>
          </value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="Toxalope"]/statBases</xpath>
          <value>
            <ArmorRating_Sharp>0.08</ArmorRating_Sharp>
          </value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="Toxalope"]/statBases</xpath>
          <value>
            <ArmorRating_Blunt>0.3</ArmorRating_Blunt>
          </value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="Toxalope"]/comps</xpath>
          <value>
            <li Class="CombatExtended.CompProperties_ArmorDurability">
              <Durability>750</Durability>
              <Regenerates>true</Regenerates>
              <RegenInterval>600</RegenInterval>
              <RegenValue>5</RegenValue>
              <MinArmorPct>0.5</MinArmorPct>
            </li>
          </value>
        </li>
        <li Class="PatchOperationAddModExtension">
          <xpath>Defs/ThingDef[defName="Toxalope"]</xpath>
          <value>
            <li Class="CombatExtended.RacePropertiesExtensionCE">
              <bodyShape>Quadruped</bodyShape>
            </li>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>/Defs/ThingDef[defName="Toxalope"]/tools</xpath>
          <value>
            <tools Inherit="False">
              <li Class="CombatExtended.ToolCE">
                <label>head</label>
                <capacities>
                  <li>Blunt</li>
                </capacities>
                <power>4.3</power>
                <armorPenetrationBlunt>3.75</armorPenetrationBlunt>
                <cooldownTime>1.75</cooldownTime>
                <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
                <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
                <chanceFactor>0.2</chanceFactor>
              </li>
              <li Class="CombatExtended.ToolCE">
                <label>left hoof</label>
                <labelNoLocation>hoof</labelNoLocation>
                <capacities>
                  <li>Blunt</li>
                </capacities>
                <power>7.8</power>
                <armorPenetrationBlunt>4.65</armorPenetrationBlunt>
                <cooldownTime>2.3</cooldownTime>
                <linkedBodyPartsGroup>FrontLeftLeg</linkedBodyPartsGroup>
              </li>
              <li Class="CombatExtended.ToolCE">
                <label>right hoof</label>
                <labelNoLocation>hoof</labelNoLocation>
                <capacities>
                  <li>Blunt</li>
                </capacities>
                <power>7.8</power>
                <armorPenetrationBlunt>4.65</armorPenetrationBlunt>
                <cooldownTime>2.3</cooldownTime>
                <linkedBodyPartsGroup>FrontRightLeg</linkedBodyPartsGroup>
              </li>
              <li Class="CombatExtended.ToolCE">
                <label>teeth</label>
                <capacities>
                  <li>Bite</li>
                </capacities>
                <power>9.9</power>
                <armorPenetrationBlunt>3.4</armorPenetrationBlunt>
                <armorPenetrationSharp>0.13</armorPenetrationSharp>
                <cooldownTime>2.8</cooldownTime>
                <linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
              </li>
            </tools>
          </value>
        </li>
      </operations>
    </match>
  </Operation>
</Patch>
