<?xml version='1.0' encoding='utf-8'?>
<Patch>
  <!---->
  <!-- Monkey -->
  <!-- Monkey StatBases -->
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "Monkey"]/statBases/MarketValue</xpath>
    <value>
      <MarketValue>125</MarketValue>
    </value>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ThingDef[defName = "Monkey"]/statBases/MoveSpeed</xpath>
    <match Class="PatchOperationReplace">
      <xpath>/Defs/ThingDef[defName = "Monkey"]/statBases/MoveSpeed</xpath>
      <value>
        <MoveSpeed>4</MoveSpeed>
      </value>
    </match>
    <nomatch Class="PatchOperationAdd">
      <xpath>/Defs/ThingDef[defName = "Monkey"]/statBases</xpath>
      <value>
        <MoveSpeed>4</MoveSpeed>
      </value>
    </nomatch>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "Monkey"]/statBases/ComfyTemperatureMin</xpath>
    <value>
      <ComfyTemperatureMin>5</ComfyTemperatureMin>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "Monkey"]/statBases/ComfyTemperatureMax</xpath>
    <value>
      <ComfyTemperatureMax>40</ComfyTemperatureMax>
    </value>
  </Operation>
  <!-- Monkey tools -->
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "Monkey"]/tools</xpath>
    <value>
      <tools>
        <li>
          <label>head</label>
          <capacities>
            <li>Blunt</li>
          </capacities>
          <power>3</power>
          <cooldownTime>1.35</cooldownTime>
          <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
          <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
          <chanceFactor>0.2</chanceFactor>
        </li>
        <li>
          <label>left fist</label>
          <labelNoLocation>fist</labelNoLocation>
          <capacities>
            <li>Blunt</li>
          </capacities>
          <power>3.5</power>
          <cooldownTime>0.9</cooldownTime>
          <linkedBodyPartsGroup>LeftHand</linkedBodyPartsGroup>
        </li>
        <li>
          <label>right fist</label>
          <labelNoLocation>fist</labelNoLocation>
          <capacities>
            <li>Blunt</li>
          </capacities>
          <power>3.5</power>
          <cooldownTime>0.9</cooldownTime>
          <linkedBodyPartsGroup>RightHand</linkedBodyPartsGroup>
        </li>
        <li>
          <label>canines</label>
          <capacities>
            <li>Bite</li>
          </capacities>
          <power>5</power>
          <cooldownTime>1.15</cooldownTime>
          <linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
        </li>
      </tools>
    </value>
  </Operation>
  <!-- Monkey RaceProperties -->
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "Monkey"]/race/baseHealthScale</xpath>
    <value>
      <baseHealthScale>0.35</baseHealthScale>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "Monkey"]/race/baseHungerRate</xpath>
    <value>
      <baseHungerRate>0.3</baseHungerRate>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "Monkey"]/race/lifeExpectancy</xpath>
    <value>
      <lifeExpectancy>25</lifeExpectancy>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "Monkey"]/race/gestationPeriodDays</xpath>
    <value>
      <gestationPeriodDays>9</gestationPeriodDays>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThingDef[defName = "Monkey"]/race</xpath>
    <value>
      <herdMigrationAllowed>false</herdMigrationAllowed>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "Monkey"]/race/foodType</xpath>
    <value>
      <foodType>OmnivoreRoughAnimal, OvivoreAnimal</foodType>
    </value>
  </Operation>
  <Operation Class="PatchOperationRemove">
    <xpath>/Defs/ThingDef[defName = "Monkey"]/race/petness</xpath>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "Monkey"]/race/nuzzleMtbHours</xpath>
    <value>
      <nuzzleMtbHours>36</nuzzleMtbHours>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "Monkey"]/race/trainability</xpath>
    <value>
      <trainability>Advanced</trainability>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThingDef[defName = "Monkey"]/race</xpath>
    <value>
      <nameOnTameChance>1</nameOnTameChance>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "Monkey"]/race/lifeStageAges</xpath>
    <value>
      <lifeStageAges>
        <li>
          <def>AnimalBaby</def>
          <minAge>0</minAge>
        </li>
        <li>
          <def>AnimalJuvenile</def>
          <minAge>0.3</minAge>
        </li>
        <li>
          <def>AnimalAdult</def>
          <minAge>0.6</minAge>
          <soundWounded>Pawn_Monkey_Wounded</soundWounded>
          <soundDeath>Pawn_Monkey_Death</soundDeath>
          <soundCall>Pawn_Monkey_Call</soundCall>
          <soundAngry>Pawn_Monkey_Angry</soundAngry>
        </li>
      </lifeStageAges>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThingDef[defName = "Monkey"]/race/specialTrainables</xpath>
    <value>
      <li MayRequire="Ludeon.RimWorld.Odyssey">Forage</li>
      <li MayRequire="Ludeon.RimWorld.Odyssey">AttackTarget</li>
    </value>
  </Operation>
  <Operation Class="PatchOperationAddModExtension">
    <xpath>/Defs/ThingDef[defName = "Monkey"]</xpath>
    <value>
      <li Class="ZoologyMod.ModExtension_IsMammal, ZoologyMod"/>
    </value>
  </Operation>
  <Operation Class="PatchOperationAddModExtension">
    <xpath>/Defs/ThingDef[defName = "Monkey"]</xpath>
    <value>
      <li Class="ZoologyMod.ModExtensiom_Chlidcare, ZoologyMod"/>
    </value>
  </Operation>
  <!-- Monkey PawnKindDef -->
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/PawnKindDef[defName = "Monkey"]/combatPower</xpath>
    <value>
      <combatPower>45</combatPower>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/PawnKindDef[defName = "Monkey"]</xpath>
    <value>
      <canArriveManhunter>false</canArriveManhunter>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/PawnKindDef[defName = "Monkey"]/wildGroupSize</xpath>
    <value>
      <wildGroupSize>5~15</wildGroupSize>
    </value>
  </Operation>
  <!-- Combat Extended specific patches -->
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Combat Extended</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
        <!-- Monkey CE patches -->
        <li Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName="Monkey"]/statBases/MeleeDodgeChance</xpath>
          <value>
            <MeleeDodgeChance>0.75</MeleeDodgeChance>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName="Monkey"]/statBases/MeleeCritChance</xpath>
          <value>
            <MeleeCritChance>0.15</MeleeCritChance>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName="Monkey"]/statBases/MeleeParryChance</xpath>
          <value>
            <MeleeParryChance>0.05</MeleeParryChance>
          </value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="Monkey"]/statBases</xpath>
          <value>
            <ArmorRating_Sharp>0.03</ArmorRating_Sharp>
          </value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="Monkey"]/statBases</xpath>
          <value>
            <ArmorRating_Blunt>0.15</ArmorRating_Blunt>
          </value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="Monkey"]</xpath>
          <value>
            <comps/>
          </value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="Monkey"]/comps</xpath>
          <value>
            <li Class="CombatExtended.CompProperties_ArmorDurability">
              <Durability>175</Durability>
              <Regenerates>true</Regenerates>
              <RegenInterval>600</RegenInterval>
              <RegenValue>5</RegenValue>
              <MinArmorPct>0.5</MinArmorPct>
            </li>
          </value>
        </li>
        <li Class="PatchOperationSequence">
          <operations>
            <li Class="PatchOperationReplace">
              <xpath>Defs/ThingDef[defName="Monkey"]/modExtensions/li[@Class="CombatExtended.RacePropertiesExtensionCE"]/bodyShape</xpath>
              <value>
                <bodyShape>Quadruped</bodyShape>
              </value>
            </li>
          </operations>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>/Defs/ThingDef[defName="Monkey"]/tools</xpath>
          <value>
            <tools>
              <li Class="CombatExtended.ToolCE">
                <label>head</label>
                <capacities>
                  <li>Blunt</li>
                </capacities>
                <power>0.3</power>
                <armorPenetrationBlunt>0.25</armorPenetrationBlunt>
                <cooldownTime>1.35</cooldownTime>
                <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
                <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
                <chanceFactor>0.2</chanceFactor>
              </li>
              <li Class="CombatExtended.ToolCE">
                <label>left fist</label>
                <labelNoLocation>fist</labelNoLocation>
                <capacities>
                  <li>Blunt</li>
                </capacities>
                <power>0.8</power>
                <armorPenetrationBlunt>0.35</armorPenetrationBlunt>
                <cooldownTime>1.15</cooldownTime>
                <linkedBodyPartsGroup>LeftHand</linkedBodyPartsGroup>
              </li>
              <li Class="CombatExtended.ToolCE">
                <label>right fist</label>
                <labelNoLocation>fist</labelNoLocation>
                <capacities>
                  <li>Blunt</li>
                </capacities>
                <power>0.8</power>
                <armorPenetrationBlunt>0.35</armorPenetrationBlunt>
                <cooldownTime>1.15</cooldownTime>
                <linkedBodyPartsGroup>RightHand</linkedBodyPartsGroup>
              </li>
              <li Class="CombatExtended.ToolCE">
                <label>canines</label>
                <capacities>
                  <li>Bite</li>
                </capacities>
                <power>4.3</power>
                <armorPenetrationBlunt>0.45</armorPenetrationBlunt>
                <armorPenetrationSharp>0.08</armorPenetrationSharp>
                <cooldownTime>1.9</cooldownTime>
                <linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
              </li>
            </tools>
          </value>
        </li>
      </operations>
    </match>
  </Operation>
</Patch>
