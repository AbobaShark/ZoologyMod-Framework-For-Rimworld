<?xml version='1.0' encoding='utf-8'?>
<Patch>
  <!---->
  <!-- BaseHare -->
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[@Name = "BaseHare"]/statBases/MarketValue</xpath>
    <value>
      <MarketValue>75</MarketValue>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[@Name = "BaseHare"]/statBases/MoveSpeed</xpath>
    <value>
      <MoveSpeed>9.5</MoveSpeed>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[@Name = "BaseHare"]/statBases/Wildness</xpath>
    <value>
      <Wildness>0.55</Wildness>
    </value>
  </Operation>
  <Operation Class="PatchOperationRemove">
    <xpath>/Defs/ThingDef[@Name = "BaseHare"]/statBases/ComfyTemperatureMin</xpath>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[@Name = "BaseHare"]/tools</xpath>
    <value>
      <tools>
        <li>
          <label>head</label>
          <capacities>
            <li>Blunt</li>
          </capacities>
          <power>2.5</power>
          <cooldownTime>1.25</cooldownTime>
          <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
          <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
          <chanceFactor>0.2</chanceFactor>
        </li>
        <li>
          <label>Incisors</label>
          <capacities>
            <li>Bite</li>
          </capacities>
          <power>2.5</power>
          <cooldownTime>1.25</cooldownTime>
          <linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
        </li>
      </tools>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[@Name = "BaseHare"]/race/baseBodySize</xpath>
    <value>
      <baseBodySize>0.3</baseBodySize>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[@Name = "BaseHare"]/race/baseHealthScale</xpath>
    <value>
      <baseHealthScale>0.3</baseHealthScale>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[@Name = "BaseHare"]/race/baseHungerRate</xpath>
    <value>
      <baseHungerRate>0.3</baseHungerRate>
    </value>
  </Operation>
  <Operation Class="PatchOperationRemove">
    <xpath>/Defs/ThingDef[@Name = "BaseHare"]/race/lifeExpectancy</xpath>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[@Name = "BaseHare"]/race/gestationPeriodDays</xpath>
    <value>
      <gestationPeriodDays>6</gestationPeriodDays>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThingDef[@Name = "BaseHare"]/race</xpath>
    <value>
      <herdMigrationAllowed>false</herdMigrationAllowed>
    </value>
  </Operation>
  <Operation Class="PatchOperationRemove">
    <xpath>/Defs/ThingDef[@Name = "BaseHare"]/race/petness</xpath>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThingDef[@Name = "BaseHare"]/race</xpath>
    <value>
      <nuzzleMtbHours>36</nuzzleMtbHours>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[@Name = "BaseHare"]/race/body</xpath>
    <value>
      <body>QuadrupedAnimalWithPaws</body>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[@Name = "BaseHare"]/race/lifeStageAges/li[def = 'AnimalJuvenile']/minAge</xpath>
    <value>
      <minAge>0.15</minAge>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[@Name = "BaseHare"]/race/lifeStageAges/li[def = 'AnimalAdult']/minAge</xpath>
    <value>
      <minAge>0.3</minAge>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThingDef[@Name = "BaseHare"]/race</xpath>
    <value>
      <specialTrainables>
        <li MayRequire="Ludeon.RimWorld.Odyssey">Comfort</li>
      </specialTrainables>
    </value>
  </Operation>
  <Operation Class="PatchOperationRemove">
    <xpath>/Defs/ThingDef[@Name = "BaseHare"]/tradeTags/li[text()="AnimalCommon" or text()="AnimalUncommon" or text()="AnimalExotic" or text()="AnimalFighter" or text()="AnimalInsect" or text()="AnimalPet" or text()="AnimalFarm"]</xpath>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThingDef[@Name = "BaseHare"]/tradeTags</xpath>
    <value>
      <li>AnimalCommon</li>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[@Name = "BaseHare"]/race/litterSizeCurve</xpath>
    <value>
      <litterSizeCurve>
        <points>
          <li>(0.4000, 0)</li>
          <li>(0.8000, 0.2)</li>
          <li>(1.6000, 1)</li>
          <li>(2.4000, 1)</li>
          <li>(3.2000, 0.2)</li>
          <li>(3.6000, 0)</li>
        </points>
      </litterSizeCurve>
    </value>
  </Operation>
  <Operation Class="PatchOperationAddModExtension">
    <xpath>/Defs/ThingDef[@Name = "BaseHare"]</xpath>
    <value>
      <li Class="ZoologyMod.ModExtension_IsMammal, ZoologyMod"/>
    </value>
  </Operation>
  <Operation Class="PatchOperationAddModExtension">
    <xpath>/Defs/ThingDef[@Name = "BaseHare"]</xpath>
    <value>
      <li Class="ZoologyMod.ModExtensiom_Chlidcare, ZoologyMod"/>
    </value>
  </Operation>
  <!-- PawnKind parent HareBase -->
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/PawnKindDef[@Name = "HareBase"]/combatPower</xpath>
    <value>
      <combatPower>45</combatPower>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/PawnKindDef[@Name = "HareBase"]/ecoSystemWeight</xpath>
    <value>
      <ecoSystemWeight>0.3</ecoSystemWeight>
    </value>
  </Operation>
  <!-- Hare -->
  <!-- Hare StatBases -->
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThingDef[defName = "Hare"]</xpath>
    <value>
      <statBases/>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThingDef[defName = "Hare"]/statBases</xpath>
    <value>
      <ComfyTemperatureMin>-45</ComfyTemperatureMin>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThingDef[defName = "Hare"]/statBases</xpath>
    <value>
      <ComfyTemperatureMax>35</ComfyTemperatureMax>
    </value>
  </Operation>
  <!-- Hare tools -->
  <!-- Hare RaceProperties -->
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThingDef[defName = "Hare"]/race</xpath>
    <value>
      <lifeExpectancy>6</lifeExpectancy>
    </value>
  </Operation>
  <!-- Hare PawnKindDef -->
  <!-- Snowhare -->
  <!-- Snowhare StatBases -->
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThingDef[defName = "Snowhare"]/statBases</xpath>
    <value>
      <ComfyTemperatureMax>10</ComfyTemperatureMax>
    </value>
  </Operation>
  <!-- Snowhare tools -->
  <!-- Snowhare RaceProperties -->
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThingDef[defName = "Snowhare"]/race</xpath>
    <value>
      <lifeExpectancy>9</lifeExpectancy>
    </value>
  </Operation>
  <!-- Snowhare PawnKindDef -->
  <!-- Combat Extended specific patches -->
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Combat Extended</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
        <!---->
        <!-- BaseHare CE tools (parent-level) -->
        <li Class="PatchOperationReplace">
          <xpath>/Defs/ThingDef[@Name="BaseHare"]/tools</xpath>
          <value>
            <tools>
              <li Class="CombatExtended.ToolCE">
                <label>head</label>
                <capacities>
                  <li>Blunt</li>
                </capacities>
                <power>0.2</power>
                <armorPenetrationBlunt>0.15</armorPenetrationBlunt>
                <cooldownTime>1.3</cooldownTime>
                <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
                <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
                <chanceFactor>0.2</chanceFactor>
              </li>
              <li Class="CombatExtended.ToolCE">
                <label>Incisors</label>
                <capacities>
                  <li>Bite</li>
                </capacities>
                <power>2.4</power>
                <armorPenetrationBlunt>0.25</armorPenetrationBlunt>
                <armorPenetrationSharp>0.05</armorPenetrationSharp>
                <cooldownTime>2.1</cooldownTime>
                <linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
              </li>
            </tools>
          </value>
        </li>
        <!---->
        <!-- BaseHare CE parent properties -->
        <li Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[@Name="BaseHare"]/statBases/MeleeDodgeChance</xpath>
          <value>
            <MeleeDodgeChance>0.55</MeleeDodgeChance>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[@Name="BaseHare"]/statBases/MeleeCritChance</xpath>
          <value>
            <MeleeCritChance>0</MeleeCritChance>
          </value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[@Name="BaseHare"]/statBases</xpath>
          <value>
            <ArmorRating_Sharp>0.03</ArmorRating_Sharp>
          </value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[@Name="BaseHare"]/statBases</xpath>
          <value>
            <ArmorRating_Blunt>0.1</ArmorRating_Blunt>
          </value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[@Name="BaseHare"]</xpath>
          <value>
            <comps/>
          </value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[@Name="BaseHare"]/comps</xpath>
          <value>
            <li Class="CombatExtended.CompProperties_ArmorDurability">
              <Durability>150</Durability>
              <Regenerates>true</Regenerates>
              <RegenInterval>600</RegenInterval>
              <RegenValue>5</RegenValue>
              <MinArmorPct>0.5</MinArmorPct>
            </li>
          </value>
        </li>
        <li Class="PatchOperationSequence">
          <operations/>
        </li>
        <!-- Hare CE patches -->
        <!-- Snowhare CE patches -->
      </operations>
    </match>
  </Operation>
</Patch>
