<?xml version='1.0' encoding='utf-8'?>
<Patch>
  <!---->
  <!-- LavaSnail -->
  <!-- LavaSnail StatBases -->
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "LavaSnail"]/statBases/MarketValue</xpath>
    <value>
      <MarketValue>175</MarketValue>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "LavaSnail"]/statBases/MoveSpeed</xpath>
    <value>
      <MoveSpeed>0.5</MoveSpeed>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "LavaSnail"]/statBases/Wildness</xpath>
    <value>
      <Wildness>0.3</Wildness>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThingDef[defName = "LavaSnail"]/statBases</xpath>
    <value>
      <FilthRate>10</FilthRate>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "LavaSnail"]/statBases/ComfyTemperatureMin</xpath>
    <value>
      <ComfyTemperatureMin>5</ComfyTemperatureMin>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "LavaSnail"]/statBases/ComfyTemperatureMax</xpath>
    <value>
      <ComfyTemperatureMax>35</ComfyTemperatureMax>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "LavaSnail"]/statBases/ArmorRating_Blunt</xpath>
    <value>
      <ArmorRating_Blunt>0.1</ArmorRating_Blunt>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "LavaSnail"]/statBases/ArmorRating_Sharp</xpath>
    <value>
      <ArmorRating_Sharp>0.6</ArmorRating_Sharp>
    </value>
  </Operation>
  <!-- LavaSnail tools -->
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "LavaSnail"]/tools</xpath>
    <value>
      <tools>
        <li>
          <label>head</label>
          <capacities>
            <li>Blunt</li>
          </capacities>
          <power>6.5</power>
          <cooldownTime>1.9</cooldownTime>
          <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
          <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
          <chanceFactor>0.2</chanceFactor>
        </li>
        <li>
          <label>radula</label>
          <capacities>
            <li>Bite</li>
          </capacities>
          <power>7</power>
          <cooldownTime>1.9</cooldownTime>
          <linkedBodyPartsGroup>Mouth</linkedBodyPartsGroup>
        </li>
      </tools>
    </value>
  </Operation>
  <!-- LavaSnail RaceProperties -->
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "LavaSnail"]/race/baseBodySize</xpath>
    <value>
      <baseBodySize>0.85</baseBodySize>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "LavaSnail"]/race/baseHealthScale</xpath>
    <value>
      <baseHealthScale>0.85</baseHealthScale>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "LavaSnail"]/race/baseHungerRate</xpath>
    <value>
      <baseHungerRate>0.1</baseHungerRate>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "LavaSnail"]/race/lifeExpectancy</xpath>
    <value>
      <lifeExpectancy>15</lifeExpectancy>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "LavaSnail"]/race/gestationPeriodDays</xpath>
    <value>
      <gestationPeriodDays>7.5</gestationPeriodDays>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThingDef[defName = "LavaSnail"]/race</xpath>
    <value>
      <herdMigrationAllowed>false</herdMigrationAllowed>
    </value>
  </Operation>
  <Operation Class="PatchOperationRemove">
    <xpath>/Defs/ThingDef[defName = "LavaSnail"]/race/roamMtbDays</xpath>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "LavaSnail"]/race/lifeStageAges</xpath>
    <value>
      <lifeStageAges>
        <li>
          <def>AnimalBaby</def>
          <minAge>0</minAge>
        </li>
        <li>
          <def>AnimalJuvenile</def>
          <minAge>0.4</minAge>
        </li>
        <li>
          <def>AnimalAdult</def>
          <minAge>0.8</minAge>
          <soundWounded>Pawn_Crab_Wounded</soundWounded>
          <soundDeath>Pawn_Crab_Death</soundDeath>
          <soundCall>Pawn_Crab_Call</soundCall>
          <soundAngry>Pawn_Crab_Angry</soundAngry>
        </li>
      </lifeStageAges>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "LavaSnail"]/race/litterSizeCurve</xpath>
    <value>
      <litterSizeCurve>
        <points>
          <li>(2.0000, 0)</li>
          <li>(4.0000, 0.2)</li>
          <li>(8.0000, 1)</li>
          <li>(12.0000, 1)</li>
          <li>(16.0000, 0.2)</li>
          <li>(18.0000, 0)</li>
        </points>
      </litterSizeCurve>
    </value>
  </Operation>
  <Operation Class="PatchOperationRemove">
    <xpath>/Defs/ThingDef[defName = "LavaSnail"]/tradeTags/li[text()='AnimalUncommon']</xpath>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThingDef[defName = "LavaSnail"]/tradeTags</xpath>
    <value>
      <li>AnimalCommon</li>
    </value>
  </Operation>
  <Operation Class="PatchOperationAddModExtension">
    <xpath>/Defs/ThingDef[defName = "LavaSnail"]</xpath>
    <value>
      <li Class="ZoologyMod.ModExtension_Ectothermic, ZoologyMod"/>
    </value>
  </Operation>
  <!-- LavaSnail PawnKindDef -->
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/PawnKindDef[defName = "LavaSnail"]/combatPower</xpath>
    <value>
      <combatPower>65</combatPower>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/PawnKindDef[defName = "LavaSnail"]/ecoSystemWeight</xpath>
    <value>
      <ecoSystemWeight>0.25</ecoSystemWeight>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/PawnKindDef[defName = "LavaSnail"]</xpath>
    <value>
      <canArriveManhunter>false</canArriveManhunter>
    </value>
  </Operation>
  <Operation Class="PatchOperationRemove">
    <xpath>/Defs/PawnKindDef[defName = "LavaSnail"]/wildGroupSize</xpath>
  </Operation>
  <!-- Combat Extended specific patches -->
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Combat Extended</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
        <!-- LavaSnail CE patches -->
        <li Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName="LavaSnail"]/statBases/ArmorRating_Sharp</xpath>
          <value>
            <ArmorRating_Sharp>1.1</ArmorRating_Sharp>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName="LavaSnail"]/statBases/ArmorRating_Blunt</xpath>
          <value>
            <ArmorRating_Blunt>0.05</ArmorRating_Blunt>
          </value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="LavaSnail"]</xpath>
          <value>
            <comps/>
          </value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="LavaSnail"]/comps</xpath>
          <value>
            <li Class="CombatExtended.CompProperties_ArmorDurability">
              <Durability>425</Durability>
              <Regenerates>true</Regenerates>
              <RegenInterval>600</RegenInterval>
              <RegenValue>5</RegenValue>
              <MinArmorPct>0.5</MinArmorPct>
            </li>
          </value>
        </li>
        <li Class="PatchOperationAddModExtension">
          <xpath>Defs/ThingDef[defName="LavaSnail"]</xpath>
          <value>
            <li Class="CombatExtended.RacePropertiesExtensionCE">
              <bodyShape>QuadrupedLow</bodyShape>
            </li>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>/Defs/ThingDef[defName="LavaSnail"]/tools</xpath>
          <value>
            <tools>
              <li Class="CombatExtended.ToolCE">
                <label>head</label>
                <capacities>
                  <li>Blunt</li>
                </capacities>
                <power>0.9</power>
                <armorPenetrationBlunt>0.7</armorPenetrationBlunt>
                <cooldownTime>2.05</cooldownTime>
                <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
                <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
                <chanceFactor>0.2</chanceFactor>
              </li>
              <li Class="CombatExtended.ToolCE">
                <label>radula</label>
                <capacities>
                  <li>Bite</li>
                </capacities>
                <power>5.7</power>
                <armorPenetrationBlunt>1.1</armorPenetrationBlunt>
                <armorPenetrationSharp>0.08</armorPenetrationSharp>
                <cooldownTime>2.25</cooldownTime>
                <linkedBodyPartsGroup>Mouth</linkedBodyPartsGroup>
              </li>
            </tools>
          </value>
        </li>
        <li Class="PatchOperationRemove">
          <xpath>Defs/ThingDef[defName="LavaSnail"]/statBases/ArmorRating_Heat</xpath>
        </li>
      </operations>
    </match>
  </Operation>
</Patch>
