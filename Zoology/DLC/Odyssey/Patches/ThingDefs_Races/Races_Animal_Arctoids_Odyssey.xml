<?xml version='1.0' encoding='utf-8'?>
<Patch>
  <!---->
  <!-- Panda -->
  <!-- Panda StatBases -->
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "Panda"]/statBases/MarketValue</xpath>
    <value>
      <MarketValue>600</MarketValue>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "Panda"]/statBases/MoveSpeed</xpath>
    <value>
      <MoveSpeed>5</MoveSpeed>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "Panda"]/statBases/Wildness</xpath>
    <value>
      <Wildness>0.7</Wildness>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "Panda"]/statBases/ComfyTemperatureMin</xpath>
    <value>
      <ComfyTemperatureMin>-35</ComfyTemperatureMin>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "Panda"]/statBases/ComfyTemperatureMax</xpath>
    <value>
      <ComfyTemperatureMax>35</ComfyTemperatureMax>
    </value>
  </Operation>
  <!-- Panda tools -->
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "Panda"]/tools</xpath>
    <value>
      <tools>
        <li>
          <label>head</label>
          <capacities>
            <li>Blunt</li>
          </capacities>
          <power>9</power>
          <cooldownTime>2.2</cooldownTime>
          <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
          <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
          <chanceFactor>0.2</chanceFactor>
        </li>
        <li>
          <label>left claw</label>
          <labelNoLocation>claw</labelNoLocation>
          <capacities>
            <li>Scratch</li>
          </capacities>
          <power>13.5</power>
          <cooldownTime>1.45</cooldownTime>
          <linkedBodyPartsGroup>FrontLeftPaw</linkedBodyPartsGroup>
        </li>
        <li>
          <label>right claw</label>
          <labelNoLocation>claw</labelNoLocation>
          <capacities>
            <li>Scratch</li>
          </capacities>
          <power>13.5</power>
          <cooldownTime>1.45</cooldownTime>
          <linkedBodyPartsGroup>FrontRightPaw</linkedBodyPartsGroup>
        </li>
        <li>
          <label>canines</label>
          <capacities>
            <li>Bite</li>
          </capacities>
          <power>15.5</power>
          <cooldownTime>1.85</cooldownTime>
          <linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
        </li>
      </tools>
    </value>
  </Operation>
  <!-- Panda RaceProperties -->
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "Panda"]/race/baseBodySize</xpath>
    <value>
      <baseBodySize>1.3</baseBodySize>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "Panda"]/race/baseHealthScale</xpath>
    <value>
      <baseHealthScale>1.55</baseHealthScale>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "Panda"]/race/baseHungerRate</xpath>
    <value>
      <baseHungerRate>0.65</baseHungerRate>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "Panda"]/race/lifeExpectancy</xpath>
    <value>
      <lifeExpectancy>20</lifeExpectancy>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "Panda"]/race/gestationPeriodDays</xpath>
    <value>
      <gestationPeriodDays>6</gestationPeriodDays>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThingDef[defName = "Panda"]/race</xpath>
    <value>
      <herdMigrationAllowed>false</herdMigrationAllowed>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThingDef[defName = "Panda"]/race</xpath>
    <value>
      <manhunterOnTameFailChance>0.025</manhunterOnTameFailChance>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThingDef[defName = "Panda"]/race</xpath>
    <value>
      <manhunterOnDamageChance>0.1</manhunterOnDamageChance>
    </value>
  </Operation>
  <Operation Class="PatchOperationRemove">
    <xpath>/Defs/ThingDef[defName = "Panda"]/race/nuzzleMtbHours</xpath>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "Panda"]/race/trainability</xpath>
    <value>
      <trainability>Advanced</trainability>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThingDef[defName = "Panda"]/race</xpath>
    <value>
      <nameOnTameChance>1</nameOnTameChance>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThingDef[defName = "Panda"]/race</xpath>
    <value>
      <useMeatFrom>Bear_Grizzly</useMeatFrom>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "Panda"]/race/lifeStageAges</xpath>
    <value>
      <lifeStageAges>
        <li>
          <def>AnimalBaby</def>
          <minAge>0</minAge>
        </li>
        <li>
          <def>AnimalJuvenile</def>
          <minAge>0.5</minAge>
        </li>
        <li>
          <def>AnimalAdult</def>
          <minAge>1</minAge>
          <soundWounded>Pawn_Bear_Injured</soundWounded>
          <soundDeath>Pawn_Bear_Death</soundDeath>
          <soundCall>Pawn_Bear_Call</soundCall>
          <soundAngry>Pawn_Bear_Angry</soundAngry>
        </li>
      </lifeStageAges>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThingDef[defName = "Panda"]/race</xpath>
    <value>
      <litterSizeCurve>
        <points>
          <li>(0.3000, 0)</li>
          <li>(0.6000, 0.2)</li>
          <li>(1.2000, 1)</li>
          <li>(1.8000, 1)</li>
          <li>(2.4000, 0.2)</li>
          <li>(2.7000, 0)</li>
        </points>
      </litterSizeCurve>
    </value>
  </Operation>
  <Operation Class="PatchOperationRemove">
    <xpath>/Defs/ThingDef[defName = "Panda"]/race/specialTrainables</xpath>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThingDef[defName = "Panda"]/tradeTags</xpath>
    <value>
      <li>AnimalFighter</li>
    </value>
  </Operation>
  <Operation Class="PatchOperationAddModExtension">
    <xpath>/Defs/ThingDef[defName = "Panda"]</xpath>
    <value>
      <li Class="ZoologyMod.ModExtension_IsMammal, ZoologyMod"/>
    </value>
  </Operation>
  <Operation Class="PatchOperationAddModExtension">
    <xpath>/Defs/ThingDef[defName = "Panda"]</xpath>
    <value>
      <li Class="ZoologyMod.ModExtensiom_Chlidcare, ZoologyMod"/>
    </value>
  </Operation>
  <!-- Panda PawnKindDef -->
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/PawnKindDef[defName = "Panda"]/combatPower</xpath>
    <value>
      <combatPower>140</combatPower>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/PawnKindDef[defName = "Panda"]/ecoSystemWeight</xpath>
    <value>
      <ecoSystemWeight>0.8</ecoSystemWeight>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/PawnKindDef[defName = "Panda"]</xpath>
    <value>
      <canArriveManhunter>false</canArriveManhunter>
    </value>
  </Operation>
  <!-- Combat Extended specific patches -->
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Combat Extended</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
        <!-- Panda CE patches -->
        <li Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="Panda"]/statBases</xpath>
          <value>
            <MeleeDodgeChance>0.3</MeleeDodgeChance>
          </value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="Panda"]/statBases</xpath>
          <value>
            <MeleeCritChance>0.35</MeleeCritChance>
          </value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="Panda"]/statBases</xpath>
          <value>
            <MeleeParryChance>0.05</MeleeParryChance>
          </value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="Panda"]/statBases</xpath>
          <value>
            <ArmorRating_Sharp>0.11</ArmorRating_Sharp>
          </value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="Panda"]/statBases</xpath>
          <value>
            <ArmorRating_Blunt>0.45</ArmorRating_Blunt>
          </value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="Panda"]</xpath>
          <value>
            <comps/>
          </value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="Panda"]/comps</xpath>
          <value>
            <li Class="CombatExtended.CompProperties_ArmorDurability">
              <Durability>725</Durability>
              <Regenerates>true</Regenerates>
              <RegenInterval>600</RegenInterval>
              <RegenValue>5</RegenValue>
              <MinArmorPct>0.5</MinArmorPct>
            </li>
          </value>
        </li>
        <li Class="PatchOperationAddModExtension">
          <xpath>Defs/ThingDef[defName="Panda"]</xpath>
          <value>
            <li Class="CombatExtended.RacePropertiesExtensionCE">
              <bodyShape>Quadruped</bodyShape>
            </li>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>/Defs/ThingDef[defName="Panda"]/tools</xpath>
          <value>
            <tools>
              <li Class="CombatExtended.ToolCE">
                <label>head</label>
                <capacities>
                  <li>Blunt</li>
                </capacities>
                <power>3.5</power>
                <armorPenetrationBlunt>3</armorPenetrationBlunt>
                <cooldownTime>1.65</cooldownTime>
                <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
                <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
                <chanceFactor>0.2</chanceFactor>
              </li>
              <li Class="CombatExtended.ToolCE">
                <label>left claw</label>
                <labelNoLocation>claw</labelNoLocation>
                <capacities>
                  <li>Scratch</li>
                </capacities>
                <power>14.5</power>
                <armorPenetrationBlunt>3.8</armorPenetrationBlunt>
                <armorPenetrationSharp>0.19</armorPenetrationSharp>
                <cooldownTime>1.5</cooldownTime>
                <linkedBodyPartsGroup>FrontLeftPaw</linkedBodyPartsGroup>
              </li>
              <li Class="CombatExtended.ToolCE">
                <label>right claw</label>
                <labelNoLocation>claw</labelNoLocation>
                <capacities>
                  <li>Scratch</li>
                </capacities>
                <power>14.5</power>
                <armorPenetrationBlunt>3.8</armorPenetrationBlunt>
                <armorPenetrationSharp>0.19</armorPenetrationSharp>
                <cooldownTime>1.5</cooldownTime>
                <linkedBodyPartsGroup>FrontRightPaw</linkedBodyPartsGroup>
              </li>
              <li Class="CombatExtended.ToolCE">
                <label>canines</label>
                <capacities>
                  <li>Bite</li>
                </capacities>
                <power>17</power>
                <armorPenetrationBlunt>5.75</armorPenetrationBlunt>
                <armorPenetrationSharp>0.29</armorPenetrationSharp>
                <cooldownTime>2.2</cooldownTime>
                <linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
              </li>
            </tools>
          </value>
        </li>
      </operations>
    </match>
  </Operation>
</Patch>
