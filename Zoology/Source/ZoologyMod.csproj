<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RimWorldVersion Condition="'$(RimWorldVersion)' == ''">1.6</RimWorldVersion>
    <TargetFramework Condition="'$(RimWorldVersion)' == '1.6'">net472</TargetFramework>
    <TargetFramework Condition="'$(RimWorldVersion)' == '1.7'">net10.0</TargetFramework>
    <DefineConstants Condition="'$(RimWorldVersion)' == '1.7'">$(DefineConstants);RIMWORLD17</DefineConstants>
    <GameRoot Condition="'$(GameRoot)' == ''">D:\SteamLibrary\steamapps\common\RimWorld</GameRoot>
    <LangVersion>latest</LangVersion>
    <AssemblyName>ZoologyMod</AssemblyName>
    <RootNamespace>ZoologyMod</RootNamespace>
    <OutputPath>..\Assemblies</OutputPath>
    <OutputPath Condition="'$(RimWorldVersion)' == '1.7'">..\1.7\Assemblies</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <IntermediateOutputPath>obj\$(RimWorldVersion)\$(Configuration)\</IntermediateOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Assembly-CSharp" Condition="'$(RimWorldVersion)' == '1.6'">
      <HintPath>RimWorldAssemblies\Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>RimWorldAssemblies\UnityEngine.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>RimWorldAssemblies\UnityEngine.UI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>RimWorldAssemblies\UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>RimWorldAssemblies\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>RimWorldAssemblies\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup Condition="'$(RimWorldVersion)' == '1.7'">
    <Reference Include="Assembly-CSharp"><HintPath>$(GameRoot)\Assembly-CSharp.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="Waylith.UnityCompat"><HintPath>$(GameRoot)\Waylith.UnityCompat.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="Waylith"><HintPath>$(GameRoot)\Waylith.dll</HintPath><Private>False</Private></Reference>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="2.4.1">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="codex-build\**\*.cs;obj\**\*.cs;bin\**\*.cs" />
  </ItemGroup>
  <Target Name="RemoveHarmonyFromOutput" AfterTargets="Build">
    <Delete Files="$(TargetDir)0Harmony.dll" />
  </Target>
</Project>
