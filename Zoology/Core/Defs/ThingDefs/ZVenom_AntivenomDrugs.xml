<?xml version='1.0' encoding='utf-8'?>
<Defs>
  <ThingDef ParentName="DrugBase">
    <defName>ZVenom_Drug_Cobra</defName>
    <label>cobra antivenom</label>
    <description>Neutralizes the matching animal toxin. Does not heal wounds or protect against later bites.</description>
    <rotatable>false</rotatable>
    <stackLimit>25</stackLimit>
    <graphicData>
      <texPath>Things/Item/ZoologyVenom/Antivenom</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>0.65</drawSize>
      <color>(0.85,1,0.85)</color>
    </graphicData>
    <statBases>
      <MarketValue>60</MarketValue>
      <Mass>0.1</Mass>
    </statBases>
    <ingestible>
      <drugCategory>Medical</drugCategory>
      <foodType>Processed</foodType>
      <baseIngestTicks>100</baseIngestTicks>
      <outcomeDoers>
        <li Class="ZoologyMod.IngestionOutcomeDoer_AnimalAntivenom, ZoologyMod">
          <venom>ZVenom_CobraNeuro</venom>
        </li>
      </outcomeDoers>
    </ingestible>
    <comps>
      <li Class="CompProperties_Drug">
        <listOrder>1000</listOrder>
        <overdoseSeverityOffset>0~0</overdoseSeverityOffset>
      </li>
    </comps>
  </ThingDef>
