<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <HediffDef>
    <defName>Zoology_Constriction</defName>
    <label>constriction</label>
    <description>A constricting predator is holding this creature, impairing circulation and breathing. Interrupting the hold releases it.</description>
    <hediffClass>ZoologyMod.Hediff_AnimalConstriction, ZoologyMod</hediffClass>
    <initialSeverity>0.001</initialSeverity><minSeverity>0</minSeverity><maxSeverity>2</maxSeverity>
    <canApplyDodChanceForCapacityChanges>false</canApplyDodChanceForCapacityChanges>
    <stages>
      <li><label>held</label><minSeverity>0</minSeverity><capMods><li><capacity>Moving</capacity><offset>-0.25</offset></li></capMods></li>
      <li><label>circulatory impairment</label><minSeverity>0.25</minSeverity><capMods>
        <li><capacity>BloodPumping</capacity><offset>-0.3</offset></li><li><capacity>Breathing</capacity><offset>-0.15</offset></li>
        <li><capacity>Moving</capacity><offset>-0.5</offset></li></capMods></li>
      <li><label>severe circulatory impairment</label><minSeverity>0.55</minSeverity><capMods>
        <li><capacity>BloodPumping</capacity><offset>-0.65</offset></li><li><capacity>Breathing</capacity><offset>-0.4</offset></li>
        <li><capacity>Consciousness</capacity><offset>-0.5</offset></li><li><capacity>Moving</capacity><offset>-0.8</offset></li></capMods></li>
      <li><label>critical circulatory impairment</label><minSeverity>0.85</minSeverity><lifeThreatening>true</lifeThreatening><capMods>
        <li><capacity>BloodPumping</capacity><offset>-0.9</offset></li><li><capacity>Breathing</capacity><offset>-0.75</offset></li>
        <li><capacity>Consciousness</capacity><offset>-0.9</offset></li><li><capacity>Moving</capacity><offset>-0.95</offset></li></capMods></li>
      <li><label>circulatory collapse</label><minSeverity>1</minSeverity><lifeThreatening>true</lifeThreatening><capMods>
        <li><capacity>BloodPumping</capacity><offset>-1</offset></li><li><capacity>Breathing</capacity><offset>-0.9</offset></li>
        <li><capacity>Consciousness</capacity><offset>-0.9</offset></li><li><capacity>Moving</capacity><offset>-0.95</offset></li></capMods></li>
      <li><label>extreme circulatory collapse</label><minSeverity>1.5</minSeverity><lifeThreatening>true</lifeThreatening><capMods>
        <li><capacity>BloodPumping</capacity><offset>-2</offset></li><li><capacity>Breathing</capacity><offset>-1.5</offset></li>
        <li><capacity>Consciousness</capacity><offset>-0.95</offset></li><li><capacity>Moving</capacity><offset>-0.95</offset></li></capMods></li>
    </stages>
  </HediffDef>
</Defs>
