<Defs>
  <HediffDef>
    <defName>ZVenom_CobraNeuro</defName>
    <label>cobra neurotoxic envenomation</label>
    <description>King-cobra-type neurotoxicity, with progressive neuromuscular and respiratory impairment.</description>
    <hediffClass>ZoologyMod.Hediff_AnimalVenom, ZoologyMod</hediffClass>
    <initialSeverity>0.001</initialSeverity>
    <minSeverity>0.0</minSeverity>
    <maxSeverity>1.0</maxSeverity>
    <tendable>true</tendable>
    <makesSickThought>true</makesSickThought>
    <canApplyDodChanceForCapacityChanges>false</canApplyDodChanceForCapacityChanges>
    <lethalSeverity>1</lethalSeverity>
    <comps>
      <li Class="HediffCompProperties_TendDuration">
        <baseTendDurationHours>12</baseTendDurationHours>
        <severityPerDayTended>-0.45</severityPerDayTended>
      </li>
      <li Class="HediffCompProperties_Immunizable">
        <severityPerDayNotImmune>0.68</severityPerDayNotImmune>
        <immunityPerDaySick>0.75</immunityPerDaySick>
        <severityPerDayImmune>-0.65</severityPerDayImmune>
        <immunityPerDayNotSick>-0.20</immunityPerDayNotSick>
      </li>
    </comps>
    <stages>
      <li>
        <label>initial</label>
        <minSeverity>0</minSeverity>
        <painOffset>0</painOffset>
      </li>
      <li>
        <label>early weakness</label>
        <minSeverity>0.25</minSeverity>
        <painOffset>0.05</painOffset>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.08</offset>
          </li>
          <li>
            <capacity>Manipulation</capacity>
            <offset>-0.05</offset>
          </li>
        </capMods>
      </li>
      <li>
        <label>neuromuscular impairment</label>
        <minSeverity>0.55</minSeverity>
        <painOffset>0.1</painOffset>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.25</offset>
          </li>
          <li>
            <capacity>Manipulation</capacity>
            <offset>-0.35</offset>
          </li>
          <li>
            <capacity>Breathing</capacity>
            <offset>-0.3</offset>
          </li>
        </capMods>
      </li>
      <li>
        <label>respiratory paralysis</label>
        <minSeverity>0.82</minSeverity>
        <painOffset>0.08</painOffset>
        <lifeThreatening>true</lifeThreatening>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.7</offset>
          </li>
          <li>
            <capacity>Manipulation</capacity>
            <offset>-0.75</offset>
          </li>
          <li>
            <capacity>Breathing</capacity>
            <offset>-0.75</offset>
          </li>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.25</offset>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>
