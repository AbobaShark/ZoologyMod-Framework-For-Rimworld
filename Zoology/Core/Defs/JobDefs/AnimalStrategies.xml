<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <JobDef>
    <defName>Zoology_AnimalStalk</defName>
    <driverClass>ZoologyMod.JobDriver_AnimalStalk, ZoologyMod</driverClass>
    <reportString>stalking prey</reportString>
    <casualInterruptible>false</casualInterruptible>
  </JobDef>
  <JobDef>
    <defName>Zoology_DigBurrow</defName>
    <driverClass>ZoologyMod.JobDriver_DigAnimalBurrow, ZoologyMod</driverClass>
    <reportString>digging a burrow</reportString>
  </JobDef>
  <JobDef>
    <defName>Zoology_EnterBurrow</defName>
    <driverClass>ZoologyMod.JobDriver_EnterAnimalBurrow, ZoologyMod</driverClass>
    <reportString>entering a burrow</reportString>
    <casualInterruptible>false</casualInterruptible>
    <neverFleeFromEnemies>true</neverFleeFromEnemies>
  </JobDef>
  <JobDef>
    <defName>Zoology_TreeRefuge</defName>
    <driverClass>ZoologyMod.JobDriver_AnimalTreeRefuge, ZoologyMod</driverClass>
    <reportString>sheltering in a tree</reportString>
    <casualInterruptible>false</casualInterruptible>
    <neverFleeFromEnemies>true</neverFleeFromEnemies>
  </JobDef>
  <JobDef>
    <defName>Zoology_SleepInTree</defName>
    <driverClass>ZoologyMod.JobDriver_AnimalTreeRefuge, ZoologyMod</driverClass>
    <reportString>sleeping in a tree</reportString>
    <casualInterruptible>false</casualInterruptible>
    <neverFleeFromEnemies>true</neverFleeFromEnemies>
  </JobDef>
  <JobDef>
    <defName>Zoology_ExcavateBurrow</defName>
    <driverClass>ZoologyMod.JobDriver_ExcavateAnimalBurrow, ZoologyMod</driverClass>
    <reportString>digging prey out of a burrow</reportString>
    <casualInterruptible>false</casualInterruptible>
    <neverFleeFromEnemies>true</neverFleeFromEnemies>
  </JobDef>
  <JobDef>
    <defName>Zoology_EnvironmentFlee</defName>
    <driverClass>ZoologyMod.JobDriver_AnimalEnvironmentFlee, ZoologyMod</driverClass>
    <reportString>escaping to favorable terrain</reportString>
    <tryStartFlying>true</tryStartFlying>
  </JobDef>
  <JobDef>
    <defName>Zoology_Constrict</defName>
    <driverClass>ZoologyMod.JobDriver_Constrict, ZoologyMod</driverClass>
    <reportString>constricting prey</reportString>
    <casualInterruptible>false</casualInterruptible>
    <neverFleeFromEnemies>true</neverFleeFromEnemies>
    <checkOverrideOnDamage>Never</checkOverrideOnDamage>
  </JobDef>
</Defs>
