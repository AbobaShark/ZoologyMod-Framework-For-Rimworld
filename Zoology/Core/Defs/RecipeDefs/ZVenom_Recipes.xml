<?xml version='1.0' encoding='utf-8'?>
<Defs>
  <RecipeDef>
    <defName>ZVenom_Make_Arachnid</defName>
    <label>make arachnid antivenom</label>
    <description>Prepare antivenom from herbal medicine and a matching animal venom sample.</description>
    <jobString>Preparing antivenom.</jobString>
    <workAmount>1200</workAmount>
    <workSpeedStat>DrugSynthesisSpeed</workSpeedStat>
    <workSkill>Intellectual</workSkill>
    <researchPrerequisite>MedicineProduction</researchPrerequisite>
    <recipeUsers>
      <li>DrugLab</li>
    </recipeUsers>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>MedicineHerbal</li>
          </thingDefs>
        </filter>
        <count>2</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>ZVenom_Sample_Arachnid</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>MedicineHerbal</li>
        <li>ZVenom_Sample_Arachnid</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <ZVenom_Drug_Arachnid>1</ZVenom_Drug_Arachnid>
    </products>
  </RecipeDef>
