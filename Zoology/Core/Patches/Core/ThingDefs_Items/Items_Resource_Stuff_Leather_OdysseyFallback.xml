<?xml version='1.0' encoding='utf-8'?>
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Odyssey</li>
    </mods>
    <nomatch Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationConditional">
          <xpath>/Defs/ThingDef[defName="Leather_Hippo"]</xpath>
          <nomatch Class="PatchOperationAdd">
            <xpath>/Defs</xpath>
            <value>
              <ThingDef ParentName="LeatherBase">
                <defName>Leather_Hippo</defName>
                <label>hippo leather</label>
                <description>Tanned, dried, scraped hippo skin. While extremely durable, it provides little protection from extreme weather.</description>
                <graphicData>
                  <color>(104,90,98)</color>
                </graphicData>
                <statBases>
                  <MarketValue>2.9</MarketValue>
                  <StuffPower_Armor_Sharp>1.12</StuffPower_Armor_Sharp>
                  <StuffPower_Armor_Blunt>0.24</StuffPower_Armor_Blunt>
                  <StuffPower_Insulation_Cold>16</StuffPower_Insulation_Cold>
                  <StuffPower_Insulation_Heat>16</StuffPower_Insulation_Heat>
                </statBases>
                <stuffProps>
                  <color>(104,90,98)</color>
                  <commonality>0.01</commonality>
                  <statFactors>
                    <MaxHitPoints>1.5</MaxHitPoints>
                    <Beauty>1</Beauty>
                  </statFactors>
                </stuffProps>
              </ThingDef>
            </value>
          </nomatch>
        </li>
        <li Class="PatchOperationConditional">
          <xpath>/Defs/ThingDef[defName="Leather_Sealskin"]</xpath>
          <nomatch Class="PatchOperationAdd">
            <xpath>/Defs</xpath>
            <value>
              <ThingDef ParentName="LeatherBase">
                <defName>Leather_Sealskin</defName>
                <label>sealskin</label>
                <description>The tanned skin of various pinnipeds, such as seals, sea lions, and walruses. It's not particularly tough but it is extremely well insulated. Sealskin is luxuriously soft to the touch, fetching a high price.</description>
                <graphicData>
                  <color>(159,159,155)</color>
                </graphicData>
                <statBases>
                  <MarketValue>3.3</MarketValue>
                  <StuffPower_Armor_Sharp>0.81</StuffPower_Armor_Sharp>
                  <StuffPower_Armor_Blunt>0.24</StuffPower_Armor_Blunt>
                  <StuffPower_Insulation_Cold>20</StuffPower_Insulation_Cold>
                  <StuffPower_Insulation_Heat>20</StuffPower_Insulation_Heat>
                </statBases>
                <stuffProps>
                  <color>(159,159,155)</color>
                  <commonality>0.025</commonality>
                  <statFactors>
                    <MaxHitPoints>1.3</MaxHitPoints>
                    <Beauty>1.5</Beauty>
                  </statFactors>
                </stuffProps>
              </ThingDef>
            </value>
          </nomatch>
        </li>
        <li Class="PatchOperationConditional">
          <xpath>/Defs/ThingDef[defName="Leather_Armadillo"]</xpath>
          <nomatch Class="PatchOperationAdd">
            <xpath>/Defs</xpath>
            <value>
              <ThingDef ParentName="LeatherBase">
                <defName>Leather_Armadillo</defName>
                <label>armadillo leather</label>
                <description>Tanned, dried, scraped armadillo skin. It's tough, but offers little protection against the elements.</description>
                <graphicData>
                  <color>(204,154,104)</color>
                </graphicData>
                <statBases>
                  <MarketValue>4</MarketValue>
                  <StuffPower_Armor_Sharp>1.29</StuffPower_Armor_Sharp>
                  <StuffPower_Armor_Blunt>0.24</StuffPower_Armor_Blunt>
                  <StuffPower_Insulation_Cold>14</StuffPower_Insulation_Cold>
                  <StuffPower_Insulation_Heat>14</StuffPower_Insulation_Heat>
                </statBases>
                <stuffProps>
                  <color>(204,154,104)</color>
                  <commonality>0.01</commonality>
                  <statFactors>
                    <MaxHitPoints>1.5</MaxHitPoints>
                    <Beauty>1.75</Beauty>
                  </statFactors>
                </stuffProps>
              </ThingDef>
            </value>
          </nomatch>
        </li>
        <li Class="PatchOperationFindMod"><mods><li>Combat Extended</li></mods><match Class="PatchOperationSequence"><operations><li Class="PatchOperationReplace"><xpath>/Defs/ThingDef[defName="Leather_Hippo"]/statBases/StuffPower_Armor_Sharp</xpath><value><StuffPower_Armor_Sharp>0.08</StuffPower_Armor_Sharp></value></li><li Class="PatchOperationReplace"><xpath>/Defs/ThingDef[defName="Leather_Hippo"]/statBases/StuffPower_Armor_Blunt</xpath><value><StuffPower_Armor_Blunt>0.064</StuffPower_Armor_Blunt></value></li><li Class="PatchOperationReplace"><xpath>/Defs/ThingDef[defName="Leather_Sealskin"]/statBases/StuffPower_Armor_Sharp</xpath><value><StuffPower_Armor_Sharp>0.05</StuffPower_Armor_Sharp></value></li><li Class="PatchOperationReplace"><xpath>/Defs/ThingDef[defName="Leather_Sealskin"]/statBases/StuffPower_Armor_Blunt</xpath><value><StuffPower_Armor_Blunt>0.04</StuffPower_Armor_Blunt></value></li><li Class="PatchOperationReplace"><xpath>/Defs/ThingDef[defName="Leather_Armadillo"]/statBases/StuffPower_Armor_Sharp</xpath><value><StuffPower_Armor_Sharp>0.09</StuffPower_Armor_Sharp></value></li><li Class="PatchOperationReplace"><xpath>/Defs/ThingDef[defName="Leather_Armadillo"]/statBases/StuffPower_Armor_Blunt</xpath><value><StuffPower_Armor_Blunt>0.064</StuffPower_Armor_Blunt></value></li></operations></match></li></operations>
    </nomatch>
  </Operation>
</Patch>