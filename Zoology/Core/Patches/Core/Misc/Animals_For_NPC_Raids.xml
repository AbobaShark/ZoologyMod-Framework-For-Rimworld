<?xml version="1.0" encoding="utf-8" ?>
<Patch>

  <!--
    Moderate NPC animal integration.

    This adds large domestic dogs to suitable combat, settlement,
    trader-guard, and Peaceful groups.

    XML only defines group weights. Each inserted option carries a runtime
    type marker so Zoology settings can disable only Zoology additions.
    Handler eligibility, ownership, point-preserving replacement, and
    close-follow combat behavior are implemented by the runtime code.

    Optional Vanilla Animals Expanded - Cats and Dogs entries are guarded
    individually with MayRequire="VanillaExpanded.VanillaAnimalsExpanded".
  -->

  <!-- Core outlanders, ordinary pirates, and ordinary tribes -->
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/FactionDef[@Name="OutlanderFactionBase"]/pawnGroupMakers/li[kindDef="Combat"][1]/options</xpath>
    <match Class="PatchOperationAdd">
      <xpath>/Defs/FactionDef[@Name="OutlanderFactionBase"]/pawnGroupMakers/li[kindDef="Combat"][1]/options</xpath>
      <value>
        <LabradorRetriever Class="ZoologyMod.ZoologyPawnGenOption, ZoologyMod">0.8</LabradorRetriever>
        <Husky Class="ZoologyMod.ZoologyPawnGenOption, ZoologyMod">0.8</Husky>
        <AEXP_GermanShepherd Class="ZoologyMod.ZoologyPawnGenOption, ZoologyMod" MayRequire="VanillaExpanded.VanillaAnimalsExpanded">0.8</AEXP_GermanShepherd>
        <AEXP_GreatDane Class="ZoologyMod.ZoologyPawnGenOption, ZoologyMod" MayRequire="VanillaExpanded.VanillaAnimalsExpanded">0.8</AEXP_GreatDane>
        <AEXP_Poodle Class="ZoologyMod.ZoologyPawnGenOption, ZoologyMod" MayRequire="VanillaExpanded.VanillaAnimalsExpanded">0.8</AEXP_Poodle>
        <AEXP_Rottweiler Class="ZoologyMod.ZoologyPawnGenOption, ZoologyMod" MayRequire="VanillaExpanded.VanillaAnimalsExpanded">0.8</AEXP_Rottweiler>
        <AEXP_WelshTerrier Class="ZoologyMod.ZoologyPawnGenOption, ZoologyMod" MayRequire="VanillaExpanded.VanillaAnimalsExpanded">0.8</AEXP_WelshTerrier>
        </value>
    </match>
