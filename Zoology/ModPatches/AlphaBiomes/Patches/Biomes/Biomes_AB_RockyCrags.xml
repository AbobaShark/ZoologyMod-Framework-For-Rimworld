<?xml version='1.0' encoding='utf-8'?>
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Alpha Biomes</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationConditional">
          <xpath>/Defs/BiomeDef[defName="AB_RockyCrags"]/wildAnimals</xpath>
          <match Class="PatchOperationRemove">
            <xpath>/Defs/BiomeDef[defName="AB_RockyCrags"]/wildAnimals</xpath>
          </match>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>/Defs/BiomeDef[defName="AB_RockyCrags"]</xpath>
          <value>
            <wildAnimals/>
          </value>
        </li>
        <li Class="PatchOperationConditional">
          <xpath>/Defs/BiomeDef[defName="AB_RockyCrags"]/pollutionWildAnimals</xpath>
          <match Class="PatchOperationRemove">
            <xpath>/Defs/BiomeDef[defName="AB_RockyCrags"]/pollutionWildAnimals</xpath>
          </match>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>/Defs/BiomeDef[defName="AB_RockyCrags"]</xpath>
          <value>
            <pollutionWildAnimals/>
          </value>
        </li>
        <li Class="PatchOperationConditional">
          <xpath>/Defs/BiomeDef[defName="AB_RockyCrags"]/coastalWildAnimals</xpath>
          <match Class="PatchOperationRemove">
            <xpath>/Defs/BiomeDef[defName="AB_RockyCrags"]/coastalWildAnimals</xpath>
          </match>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>/Defs/BiomeDef[defName="AB_RockyCrags"]</xpath>
          <value>
            <coastalWildAnimals/>
          </value>
        </li>
        <li Class="PatchOperationConditional">
          <xpath>/Defs/BiomeDef[defName="AB_RockyCrags"]/allowedPackAnimals</xpath>
          <nomatch Class="PatchOperationAdd">
            <xpath>/Defs/BiomeDef[defName="AB_RockyCrags"]</xpath>
            <value>
              <allowedPackAnimals/>
            </value>
          </nomatch>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>/Defs/BiomeDef[defName="AB_RockyCrags"]/wildAnimals</xpath>
          <value>
            <Rat>0.5</Rat>
            <AA_Behemoth MayRequire="sarg.alphaanimals">0.1</AA_Behemoth>
            <AA_CrepuscularBeetle MayRequire="sarg.alphaanimals">0.125</AA_CrepuscularBeetle>
            <AA_Darkbeast MayRequire="sarg.alphaanimals">0.015</AA_Darkbeast>
            <AA_DarkVandal MayRequire="sarg.alphaanimals">0.175</AA_DarkVandal>
            <AA_DuskProwler MayRequire="sarg.alphaanimals">0.2</AA_DuskProwler>
            <AA_DuskRat MayRequire="sarg.alphaanimals">0.5</AA_DuskRat>
            <AA_Murkling MayRequire="sarg.alphaanimals">0.075</AA_Murkling>
            <AA_NightAve MayRequire="sarg.alphaanimals">0.175</AA_NightAve>
            <AA_NightMule MayRequire="sarg.alphaanimals">0.15</AA_NightMule>
            <AA_NightRam MayRequire="sarg.alphaanimals">0.175</AA_NightRam>
            <AA_Nightling MayRequire="sarg.alphaanimals">0.05</AA_Nightling>
            <AA_ShadowCharger MayRequire="sarg.alphaanimals">0.15</AA_ShadowCharger>
            <AA_Thunderbeast MayRequire="sarg.alphaanimals">0.015</AA_Thunderbeast>
            <AA_WindBeast MayRequire="sarg.alphaanimals">0.015</AA_WindBeast>
          </value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>/Defs/BiomeDef[defName="AB_RockyCrags"]/pollutionWildAnimals</xpath>
          <value>
            <Rat>0.1</Rat>
            <AA_DuskRat MayRequire="sarg.alphaanimals">0.1</AA_DuskRat>
          </value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>/Defs/BiomeDef[defName="AB_RockyCrags"]/coastalWildAnimals</xpath>
          <value/>
        </li>
        <li Class="PatchOperationConditional">
          <xpath>/Defs/BiomeDef[defName="AB_RockyCrags"]/allowedPackAnimals/li[text()="AA_Behemoth"]</xpath>
          <nomatch Class="PatchOperationAdd">
            <xpath>/Defs/BiomeDef[defName="AB_RockyCrags"]/allowedPackAnimals</xpath>
            <value>
              <li MayRequire="sarg.alphaanimals">AA_Behemoth</li>
            </value>
          </nomatch>
        </li>
        <li Class="PatchOperationConditional">
          <xpath>/Defs/BiomeDef[defName="AB_RockyCrags"]/allowedPackAnimals/li[text()="AA_CrepuscularBeetle"]</xpath>
          <nomatch Class="PatchOperationAdd">
            <xpath>/Defs/BiomeDef[defName="AB_RockyCrags"]/allowedPackAnimals</xpath>
            <value>
              <li MayRequire="sarg.alphaanimals">AA_CrepuscularBeetle</li>
            </value>
          </nomatch>
        </li>
        <li Class="PatchOperationConditional">
          <xpath>/Defs/BiomeDef[defName="AB_RockyCrags"]/allowedPackAnimals/li[text()="AA_NightAve"]</xpath>
          <nomatch Class="PatchOperationAdd">
            <xpath>/Defs/BiomeDef[defName="AB_RockyCrags"]/allowedPackAnimals</xpath>
            <value>
              <li MayRequire="sarg.alphaanimals">AA_NightAve</li>
            </value>
          </nomatch>
        </li>
        <li Class="PatchOperationConditional">
          <xpath>/Defs/BiomeDef[defName="AB_RockyCrags"]/allowedPackAnimals/li[text()="AA_NightMule"]</xpath>
          <nomatch Class="PatchOperationAdd">
            <xpath>/Defs/BiomeDef[defName="AB_RockyCrags"]/allowedPackAnimals</xpath>
            <value>
              <li MayRequire="sarg.alphaanimals">AA_NightMule</li>
            </value>
          </nomatch>
        </li>
        <li Class="PatchOperationConditional">
          <xpath>/Defs/BiomeDef[defName="AB_RockyCrags"]/allowedPackAnimals/li[text()="Horse"]</xpath>
          <nomatch Class="PatchOperationAdd">
            <xpath>/Defs/BiomeDef[defName="AB_RockyCrags"]/allowedPackAnimals</xpath>
            <value>
              <li>Horse</li>
            </value>
          </nomatch>
        </li>
      </operations>
    </match>
  </Operation>
</Patch>
