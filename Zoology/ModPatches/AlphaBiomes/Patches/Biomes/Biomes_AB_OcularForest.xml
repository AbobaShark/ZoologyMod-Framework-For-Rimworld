<?xml version='1.0' encoding='utf-8'?>
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Alpha Biomes</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationConditional">
          <xpath>/Defs/BiomeDef[defName="AB_OcularForest"]/wildAnimals</xpath>
          <match Class="PatchOperationRemove">
            <xpath>/Defs/BiomeDef[defName="AB_OcularForest"]/wildAnimals</xpath>
          </match>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>/Defs/BiomeDef[defName="AB_OcularForest"]</xpath>
          <value>
            <wildAnimals/>
          </value>
        </li>
        <li Class="PatchOperationConditional">
          <xpath>/Defs/BiomeDef[defName="AB_OcularForest"]/pollutionWildAnimals</xpath>
          <match Class="PatchOperationRemove">
            <xpath>/Defs/BiomeDef[defName="AB_OcularForest"]/pollutionWildAnimals</xpath>
          </match>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>/Defs/BiomeDef[defName="AB_OcularForest"]</xpath>
          <value>
            <pollutionWildAnimals/>
          </value>
        </li>
        <li Class="PatchOperationConditional">
          <xpath>/Defs/BiomeDef[defName="AB_OcularForest"]/coastalWildAnimals</xpath>
          <match Class="PatchOperationRemove">
            <xpath>/Defs/BiomeDef[defName="AB_OcularForest"]/coastalWildAnimals</xpath>
          </match>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>/Defs/BiomeDef[defName="AB_OcularForest"]</xpath>
          <value>
            <coastalWildAnimals/>
          </value>
        </li>
        <li Class="PatchOperationConditional">
          <xpath>/Defs/BiomeDef[defName="AB_OcularForest"]/allowedPackAnimals</xpath>
          <nomatch Class="PatchOperationAdd">
            <xpath>/Defs/BiomeDef[defName="AB_OcularForest"]</xpath>
            <value>
              <allowedPackAnimals/>
            </value>
          </nomatch>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>/Defs/BiomeDef[defName="AB_OcularForest"]/wildAnimals</xpath>
          <value>
            <Rat>0.5</Rat>
            <Sparrow MayRequire="Ludeon.RimWorld.Odyssey">0.5</Sparrow>
            <Crow MayRequire="Ludeon.RimWorld.Odyssey">0.5</Crow>
            <AA_InfectedAerofleet MayRequire="sarg.alphaanimals">0.2</AA_InfectedAerofleet>
            <AA_Darkbeast MayRequire="sarg.alphaanimals">0.015</AA_Darkbeast>
            <AA_Eyeling MayRequire="sarg.alphaanimals">0.325</AA_Eyeling>
            <AA_MatureFleshbeast MayRequire="sarg.alphaanimals">0.1</AA_MatureFleshbeast>
            <AA_OcularJelly MayRequire="sarg.alphaanimals">0.15</AA_OcularJelly>
            <AA_OcularNightling MayRequire="sarg.alphaanimals">0.05</AA_OcularNightling>
            <AA_RedGoo MayRequire="sarg.alphaanimals">0.225</AA_RedGoo>
            <AA_RedSpore MayRequire="sarg.alphaanimals">0.1</AA_RedSpore>
            <AA_Thunderbeast MayRequire="sarg.alphaanimals">0.015</AA_Thunderbeast>
            <AA_WindBeast MayRequire="sarg.alphaanimals">0.015</AA_WindBeast>
          </value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>/Defs/BiomeDef[defName="AB_OcularForest"]/pollutionWildAnimals</xpath>
          <value>
            <Rat>0.1</Rat>
            <Sparrow MayRequire="Ludeon.RimWorld.Odyssey">0.5</Sparrow>
            <Crow MayRequire="Ludeon.RimWorld.Odyssey">0.05</Crow>
          </value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>/Defs/BiomeDef[defName="AB_OcularForest"]/coastalWildAnimals</xpath>
          <value/>
        </li>
        <li Class="PatchOperationConditional">
          <xpath>/Defs/BiomeDef[defName="AB_OcularForest"]/allowedPackAnimals/li[text()="Horse"]</xpath>
          <nomatch Class="PatchOperationAdd">
            <xpath>/Defs/BiomeDef[defName="AB_OcularForest"]/allowedPackAnimals</xpath>
            <value>
              <li>Horse</li>
            </value>
          </nomatch>
        </li>
      </operations>
    </match>
  </Operation>
</Patch>
