<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Alpha Animals' arctic lion gains masterless, map-wide Zoology Draft only
       while carrying Odyssey's sentience catalyst. Other species are unchanged. -->
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThingDef[defName="AA_ArcticLion"]/modExtensions</xpath>
    <value>
      <li Class="ZoologyMod.ModExtension_AnimalDraftRules, ZoologyMod">
        <masterlessHediffDefName>SentienceCatalyst</masterlessHediffDefName>
      </li>
    </value>
  </Operation>
</Patch>
