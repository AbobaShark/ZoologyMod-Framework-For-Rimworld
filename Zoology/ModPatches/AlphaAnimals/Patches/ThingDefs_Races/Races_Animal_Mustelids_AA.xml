<?xml version='1.0' encoding='utf-8'?>
<Patch>
  <!---->
  <!-- AA_DarkVandal -->
  <!-- AA_DarkVandal StatBases -->
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "AA_DarkVandal"]/statBases/MarketValue</xpath>
    <value>
      <MarketValue>800</MarketValue>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "AA_DarkVandal"]/statBases/MoveSpeed</xpath>
    <value>
      <MoveSpeed>7</MoveSpeed>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "AA_DarkVandal"]/statBases/Wildness</xpath>
    <value>
      <Wildness>0.9</Wildness>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "AA_DarkVandal"]/statBases/FilthRate</xpath>
    <value>
      <FilthRate>2</FilthRate>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "AA_DarkVandal"]/statBases/ComfyTemperatureMin</xpath>
    <value>
      <ComfyTemperatureMin>-30</ComfyTemperatureMin>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThingDef[defName = "AA_DarkVandal"]/statBases</xpath>
    <value>
      <ComfyTemperatureMax>35</ComfyTemperatureMax>
    </value>
  </Operation>
  <!-- AA_DarkVandal tools -->
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "AA_DarkVandal"]/tools</xpath>
    <value>
      <tools>
        <li>
          <label>head</label>
          <capacities>
            <li>Blunt</li>
          </capacities>
          <power>10.5</power>
          <cooldownTime>2.35</cooldownTime>
          <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
          <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
          <chanceFactor>0.2</chanceFactor>
        </li>
        <li>
          <label>canines</label>
          <capacities>
            <li>Bite</li>
          </capacities>
          <power>21</power>
          <cooldownTime>1.9</cooldownTime>
          <linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
          <surpriseAttack>
            <extraMeleeDamages>
              <li>
                <def>Stun</def>
                <amount>25</amount>
              </li>
            </extraMeleeDamages>
          </surpriseAttack>
        </li>
      </tools>
    </value>
  </Operation>
  <!-- AA_DarkVandal RaceProperties -->
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "AA_DarkVandal"]/race/baseBodySize</xpath>
    <value>
      <baseBodySize>1.7</baseBodySize>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "AA_DarkVandal"]/race/baseHealthScale</xpath>
    <value>
      <baseHealthScale>2.05</baseHealthScale>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "AA_DarkVandal"]/race/baseHungerRate</xpath>
    <value>
      <baseHungerRate>0.8</baseHungerRate>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "AA_DarkVandal"]/race/lifeExpectancy</xpath>
    <value>
      <lifeExpectancy>35</lifeExpectancy>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "AA_DarkVandal"]/race/gestationPeriodDays</xpath>
    <value>
      <gestationPeriodDays>9.5</gestationPeriodDays>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThingDef[defName = "AA_DarkVandal"]/race</xpath>
    <value>
      <herdMigrationAllowed>false</herdMigrationAllowed>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "AA_DarkVandal"]/race/foodType</xpath>
    <value>
      <foodType>OmnivoreAnimal, OvivoreAnimal</foodType>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "AA_DarkVandal"]/race/manhunterOnTameFailChance</xpath>
    <value>
      <manhunterOnTameFailChance>0.1</manhunterOnTameFailChance>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "AA_DarkVandal"]/race/manhunterOnDamageChance</xpath>
    <value>
      <manhunterOnDamageChance>0.3</manhunterOnDamageChance>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThingDef[defName = "AA_DarkVandal"]/race</xpath>
    <value>
      <predator>true</predator>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThingDef[defName = "AA_DarkVandal"]/race</xpath>
    <value>
      <maxPreyBodySize>4.5</maxPreyBodySize>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThingDef[defName = "AA_DarkVandal"]/race</xpath>
    <value>
      <nameOnTameChance>1</nameOnTameChance>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "AA_DarkVandal"]/race/body</xpath>
    <value>
      <body>QuadrupedAnimalWithPawsAndTail</body>
    </value>
  </Operation>
  <Operation Class="PatchOperationRemove">
    <xpath>/Defs/ThingDef[defName = "AA_DarkVandal"]/race/wildBiomes</xpath>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "AA_DarkVandal"]/race/lifeStageAges</xpath>
    <value>
      <lifeStageAges>
        <li>
          <def>AnimalBaby</def>
          <minAge>0</minAge>
        </li>
        <li>
          <def>AnimalJuvenile</def>
          <minAge>0.4</minAge>
        </li>
        <li>
          <def>AnimalAdult</def>
          <minAge>0.8</minAge>
          <soundWounded>Pawn_Wildboar_Wounded</soundWounded>
          <soundDeath>Pawn_Wildboar_Death</soundDeath>
          <soundCall>Pawn_Wildboar_Call</soundCall>
          <soundAngry>Pawn_Wildboar_Angry</soundAngry>
        </li>
      </lifeStageAges>
    </value>
  </Operation>
  <Operation Class="PatchOperationRemove">
    <xpath>/Defs/ThingDef[defName = "AA_DarkVandal"]/race/litterSizeCurve</xpath>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThingDef[defName = "AA_DarkVandal"]/race/specialTrainables</xpath>
    <value>
      <li MayRequire="Ludeon.RimWorld.Odyssey">AttackTarget</li>
      <li MayRequire="Ludeon.RimWorld.Odyssey">Forage</li>
    </value>
  </Operation>
  <Operation Class="PatchOperationRemove">
    <xpath>/Defs/ThingDef[defName = "AA_DarkVandal"]/tradeTags/li[text()='AnimalUncommon']</xpath>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThingDef[defName = "AA_DarkVandal"]/tradeTags</xpath>
    <value>
      <li>AnimalCommon</li>
      <li>AnimalFighter</li>
    </value>
  </Operation>
  <Operation Class="PatchOperationAddModExtension">
    <xpath>/Defs/ThingDef[defName = "AA_DarkVandal"]</xpath>
    <value>
      <li Class="ZoologyMod.ModExtension_IsMammal, ZoologyMod"/>
    </value>
  </Operation>
  <Operation Class="PatchOperationAddModExtension">
    <xpath>/Defs/ThingDef[defName = "AA_DarkVandal"]</xpath>
    <value>
      <li Class="ZoologyMod.ModExtensiom_Chlidcare, ZoologyMod"/>
    </value>
  </Operation>
  <!-- AA_DarkVandal PawnKindDef -->
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/PawnKindDef[defName = "AA_DarkVandal"]/combatPower</xpath>
    <value>
      <combatPower>195</combatPower>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/PawnKindDef[defName = "AA_DarkVandal"]/ecoSystemWeight</xpath>
    <value>
      <ecoSystemWeight>1</ecoSystemWeight>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/PawnKindDef[defName = "AA_DarkVandal"]/wildGroupSize</xpath>
    <value>
      <wildGroupSize>2~6</wildGroupSize>
    </value>
  </Operation>
  <!-- Combat Extended specific patches -->
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Combat Extended</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
        <!-- AA_DarkVandal CE patches -->
        <li Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="AA_DarkVandal"]/statBases</xpath>
          <value>
            <MeleeDodgeChance>0.4</MeleeDodgeChance>
          </value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="AA_DarkVandal"]/statBases</xpath>
          <value>
            <MeleeCritChance>0.45</MeleeCritChance>
          </value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="AA_DarkVandal"]/statBases</xpath>
          <value>
            <MeleeParryChance>0.05</MeleeParryChance>
          </value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="AA_DarkVandal"]/statBases</xpath>
          <value>
            <ArmorRating_Sharp>0.13</ArmorRating_Sharp>
          </value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="AA_DarkVandal"]/statBases</xpath>
          <value>
            <ArmorRating_Blunt>0.55</ArmorRating_Blunt>
          </value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="AA_DarkVandal"]/comps</xpath>
          <value>
            <li Class="CombatExtended.CompProperties_ArmorDurability">
              <Durability>950</Durability>
              <Regenerates>true</Regenerates>
              <RegenInterval>600</RegenInterval>
              <RegenValue>5</RegenValue>
              <MinArmorPct>0.5</MinArmorPct>
            </li>
          </value>
        </li>
        <li Class="PatchOperationAddModExtension">
          <xpath>Defs/ThingDef[defName="AA_DarkVandal"]</xpath>
          <value>
            <li Class="CombatExtended.RacePropertiesExtensionCE">
              <bodyShape>Quadruped</bodyShape>
            </li>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>/Defs/ThingDef[defName="AA_DarkVandal"]/tools</xpath>
          <value>
            <tools>
              <li Class="CombatExtended.ToolCE">
                <label>head</label>
                <capacities>
                  <li>Blunt</li>
                </capacities>
                <power>5</power>
                <armorPenetrationBlunt>4.4</armorPenetrationBlunt>
                <cooldownTime>2.15</cooldownTime>
                <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
                <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
                <chanceFactor>0.2</chanceFactor>
              </li>
              <li Class="CombatExtended.ToolCE">
                <label>canines</label>
                <capacities>
                  <li>Bite</li>
                </capacities>
                <power>30.3</power>
                <armorPenetrationBlunt>19.7</armorPenetrationBlunt>
                <armorPenetrationSharp>0.81</armorPenetrationSharp>
                <cooldownTime>2.4</cooldownTime>
                <linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
                <surpriseAttack>
                  <extraMeleeDamages>
                    <li>
                      <def>Stun</def>
                      <amount>25</amount>
                    </li>
                  </extraMeleeDamages>
                </surpriseAttack>
              </li>
            </tools>
          </value>
        </li>
      </operations>
    </match>
  </Operation>
</Patch>
