<?xml version='1.0' encoding='utf-8'?>
<Patch>
  <Operation Class="PatchOperationAttributeSet">
    <xpath>Defs/ManeuverDef[starts-with(defName,"ZVenom_")]/verb</xpath>
    <attribute>Class</attribute>
    <value>CombatExtended.VerbPropertiesCE</value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ManeuverDef[starts-with(defName,"ZVenom_")]/verb/verbClass</xpath>
    <value>
      <verbClass>CombatExtended.Verb_MeleeAttackCE</verbClass>
    </value>
  </Operation>
  <Operation Class="PatchOperationAddModExtension">
    <xpath>Defs/ToolCapacityDef[starts-with(defName,"ZVenom_") and not(defName="ZVenom_PlatypusSpur")]</xpath>
    <value>
      <li Class="CombatExtended.ModExtensionMeleeToolPenetration">
        <canHitInternal>true</canHitInternal>
      </li>
    </value>
  </Operation>
</Patch>