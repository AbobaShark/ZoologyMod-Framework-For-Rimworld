<?xml version='1.0' encoding='utf-8'?>
<Patch>
  <!---->
  <!-- AEXP_WildGoose -->
  <!-- AEXP_WildGoose StatBases -->
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "AEXP_WildGoose"]/statBases/MarketValue</xpath>
    <value>
      <MarketValue>150</MarketValue>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "AEXP_WildGoose"]/statBases/MoveSpeed</xpath>
    <value>
      <MoveSpeed>1.5</MoveSpeed>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "AEXP_WildGoose"]/statBases/Wildness</xpath>
    <value>
      <Wildness>0.55</Wildness>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "AEXP_WildGoose"]/statBases/FilthRate</xpath>
    <value>
      <FilthRate>3</FilthRate>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "AEXP_WildGoose"]/statBases/ComfyTemperatureMin</xpath>
    <value>
      <ComfyTemperatureMin>-35</ComfyTemperatureMin>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThingDef[defName = "AEXP_WildGoose"]/statBases</xpath>
    <value>
      <ComfyTemperatureMax>35</ComfyTemperatureMax>
    </value>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ThingDef[defName = "AEXP_WildGoose"]/statBases/ArmorRating_Blunt</xpath>
    <match Class="PatchOperationRemove">
      <xpath>/Defs/ThingDef[defName = "AEXP_WildGoose"]/statBases/ArmorRating_Blunt</xpath>
    </match>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ThingDef[defName = "AEXP_WildGoose"]/statBases/ArmorRating_Sharp</xpath>
    <match Class="PatchOperationRemove">
      <xpath>/Defs/ThingDef[defName = "AEXP_WildGoose"]/statBases/ArmorRating_Sharp</xpath>
    </match>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "AEXP_WildGoose"]/statBases/LeatherAmount</xpath>
    <value>
      <LeatherAmount>0</LeatherAmount>
    </value>
  </Operation>
  <!-- AEXP_WildGoose tools -->
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ThingDef[defName = "AEXP_WildGoose"]/tools</xpath>
    <match Class="PatchOperationRemove">
      <xpath>/Defs/ThingDef[defName = "AEXP_WildGoose"]/tools</xpath>
    </match>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThingDef[defName = "AEXP_WildGoose"]</xpath>
    <value>
      <tools>
        <li>
          <label>head</label>
          <capacities>
            <li>Blunt</li>
          </capacities>
          <power>2.5</power>
          <cooldownTime>1.2</cooldownTime>
          <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
          <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
          <chanceFactor>0.2</chanceFactor>
        </li>
        <li>
          <label>beak</label>
          <capacities>
            <li>Blunt</li>
          </capacities>
          <power>2</power>
          <cooldownTime>0.95</cooldownTime>
          <linkedBodyPartsGroup>Beak</linkedBodyPartsGroup>
        </li>
      </tools>
    </value>
  </Operation>
  <!-- AEXP_WildGoose RaceProperties -->
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "AEXP_WildGoose"]/race/baseBodySize</xpath>
    <value>
      <baseBodySize>0.25</baseBodySize>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "AEXP_WildGoose"]/race/baseHealthScale</xpath>
    <value>
      <baseHealthScale>0.25</baseHealthScale>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "AEXP_WildGoose"]/race/lifeExpectancy</xpath>
    <value>
      <lifeExpectancy>20</lifeExpectancy>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThingDef[defName = "AEXP_WildGoose"]/race</xpath>
    <value>
      <herdAnimal>true</herdAnimal>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThingDef[defName = "AEXP_WildGoose"]/race</xpath>
    <value>
      <herdMigrationAllowed>false</herdMigrationAllowed>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "AEXP_WildGoose"]/race/roamMtbDays</xpath>
    <value>
      <roamMtbDays>4</roamMtbDays>
    </value>
  </Operation>
  <Operation Class="PatchOperationRemove">
    <xpath>/Defs/ThingDef[defName = "AEXP_WildGoose"]/race/leatherDef</xpath>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "AEXP_WildGoose"]/race/manhunterOnTameFailChance</xpath>
    <value>
      <manhunterOnTameFailChance>0</manhunterOnTameFailChance>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "AEXP_WildGoose"]/race/manhunterOnDamageChance</xpath>
    <value>
      <manhunterOnDamageChance>0</manhunterOnDamageChance>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "AEXP_WildGoose"]/race/mateMtbHours</xpath>
    <value>
      <mateMtbHours>12</mateMtbHours>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThingDef[defName = "AEXP_WildGoose"]/race</xpath>
    <value>
      <waterCellCost>1</waterCellCost>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThingDef[defName = "AEXP_WildGoose"]/race</xpath>
    <value>
      <waterSeeker>true</waterSeeker>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "AEXP_WildGoose"]/race/useMeatFrom</xpath>
    <value>
      <useMeatFrom>Goose</useMeatFrom>
    </value>
  </Operation>
  <Operation Class="PatchOperationRemove">
    <xpath>/Defs/ThingDef[defName = "AEXP_WildGoose"]/race/wildBiomes</xpath>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "AEXP_WildGoose"]/race/lifeStageAges</xpath>
    <value>
      <lifeStageAges>
        <li>
          <def>AnimalBabyTiny</def>
          <minAge>0</minAge>
        </li>
        <li>
          <def>AnimalJuvenile</def>
          <minAge>0.2</minAge>
        </li>
        <li>
          <def>AnimalAdult</def>
          <minAge>0.4</minAge>
          <soundWounded>Pawn_Goose_Wounded</soundWounded>
          <soundDeath>Pawn_Goose_Death</soundDeath>
          <soundCall>Pawn_Goose_Call</soundCall>
          <soundAngry>Pawn_Goose_Angry</soundAngry>
        </li>
      </lifeStageAges>
    </value>
  </Operation>
  <Operation Class="PatchOperationRemove">
    <xpath>/Defs/ThingDef[defName = "AEXP_WildGoose"]/tradeTags/li[text()='AnimalCommon']</xpath>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThingDef[defName = "AEXP_WildGoose"]/tradeTags</xpath>
    <value>
      <li>AnimalUncommon</li>
    </value>
  </Operation>
  <Operation Class="PatchOperationAddModExtension">
    <xpath>/Defs/ThingDef[defName = "AEXP_WildGoose"]</xpath>
    <value>
      <li Class="ZoologyMod.ModExtensiom_Chlidcare, ZoologyMod"/>
    </value>
  </Operation>
  <!-- AEXP_WildGoose PawnKindDef -->
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/PawnKindDef[defName = "AEXP_WildGoose"]/combatPower</xpath>
    <value>
      <combatPower>25</combatPower>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/PawnKindDef[defName = "AEXP_WildGoose"]/ecoSystemWeight</xpath>
    <value>
      <ecoSystemWeight>0.35</ecoSystemWeight>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/PawnKindDef[defName = "AEXP_WildGoose"]</xpath>
    <value>
      <canArriveManhunter>false</canArriveManhunter>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/PawnKindDef[defName = "AEXP_WildGoose"]</xpath>
    <value>
      <wildGroupSize>3~8</wildGroupSize>
    </value>
  </Operation>
  <!-- Combat Extended specific patches -->
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Combat Extended</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
        <!-- AEXP_WildGoose CE patches -->
        <li Class="PatchOperationConditional">
          <xpath>Defs/ThingDef[defName="AEXP_WildGoose"]/statBases/MeleeDodgeChance</xpath>
          <match Class="PatchOperationReplace">
            <xpath>Defs/ThingDef[defName="AEXP_WildGoose"]/statBases/MeleeDodgeChance</xpath>
            <value>
              <MeleeDodgeChance>0.85</MeleeDodgeChance>
            </value>
          </match>
          <nomatch Class="PatchOperationAdd">
            <xpath>Defs/ThingDef[defName="AEXP_WildGoose"]/statBases</xpath>
            <value>
              <MeleeDodgeChance>0.85</MeleeDodgeChance>
            </value>
          </nomatch>
        </li>
        <li Class="PatchOperationConditional">
          <xpath>Defs/ThingDef[defName="AEXP_WildGoose"]/statBases/MeleeCritChance</xpath>
          <match Class="PatchOperationReplace">
            <xpath>Defs/ThingDef[defName="AEXP_WildGoose"]/statBases/MeleeCritChance</xpath>
            <value>
              <MeleeCritChance>0</MeleeCritChance>
            </value>
          </match>
          <nomatch Class="PatchOperationAdd">
            <xpath>Defs/ThingDef[defName="AEXP_WildGoose"]/statBases</xpath>
            <value>
              <MeleeCritChance>0</MeleeCritChance>
            </value>
          </nomatch>
        </li>
        <li Class="PatchOperationConditional">
          <xpath>Defs/ThingDef[defName="AEXP_WildGoose"]/statBases/MeleeParryChance</xpath>
          <match Class="PatchOperationReplace">
            <xpath>Defs/ThingDef[defName="AEXP_WildGoose"]/statBases/MeleeParryChance</xpath>
            <value>
              <MeleeParryChance>0</MeleeParryChance>
            </value>
          </match>
          <nomatch Class="PatchOperationAdd">
            <xpath>Defs/ThingDef[defName="AEXP_WildGoose"]/statBases</xpath>
            <value>
              <MeleeParryChance>0</MeleeParryChance>
            </value>
          </nomatch>
        </li>
        <li Class="PatchOperationConditional">
          <xpath>Defs/ThingDef[defName="AEXP_WildGoose"]/statBases/ArmorRating_Sharp</xpath>
          <match Class="PatchOperationReplace">
            <xpath>Defs/ThingDef[defName="AEXP_WildGoose"]/statBases/ArmorRating_Sharp</xpath>
            <value>
              <ArmorRating_Sharp>0</ArmorRating_Sharp>
            </value>
          </match>
          <nomatch Class="PatchOperationAdd">
            <xpath>Defs/ThingDef[defName="AEXP_WildGoose"]/statBases</xpath>
            <value>
              <ArmorRating_Sharp>0</ArmorRating_Sharp>
            </value>
          </nomatch>
        </li>
        <li Class="PatchOperationConditional">
          <xpath>Defs/ThingDef[defName="AEXP_WildGoose"]/statBases/ArmorRating_Blunt</xpath>
          <match Class="PatchOperationReplace">
            <xpath>Defs/ThingDef[defName="AEXP_WildGoose"]/statBases/ArmorRating_Blunt</xpath>
            <value>
              <ArmorRating_Blunt>0</ArmorRating_Blunt>
            </value>
          </match>
          <nomatch Class="PatchOperationAdd">
            <xpath>Defs/ThingDef[defName="AEXP_WildGoose"]/statBases</xpath>
            <value>
              <ArmorRating_Blunt>0</ArmorRating_Blunt>
            </value>
          </nomatch>
        </li>
        <li Class="PatchOperationConditional">
          <xpath>Defs/ThingDef[defName="AEXP_WildGoose"]/comps</xpath>
          <nomatch Class="PatchOperationAdd">
            <xpath>Defs/ThingDef[defName="AEXP_WildGoose"]</xpath>
            <value>
              <comps/>
            </value>
          </nomatch>
        </li>
        <li Class="PatchOperationConditional">
          <xpath>Defs/ThingDef[defName="AEXP_WildGoose"]/comps/li[@Class="CombatExtended.CompProperties_ArmorDurability"]</xpath>
          <match Class="PatchOperationReplace">
            <xpath>Defs/ThingDef[defName="AEXP_WildGoose"]/comps/li[@Class="CombatExtended.CompProperties_ArmorDurability"]/Durability</xpath>
            <value>
              <Durability>125</Durability>
            </value>
          </match>
          <nomatch Class="PatchOperationAdd">
            <xpath>Defs/ThingDef[defName="AEXP_WildGoose"]/comps</xpath>
            <value>
              <li Class="CombatExtended.CompProperties_ArmorDurability">
                <Durability>125</Durability>
                <Regenerates>true</Regenerates>
                <RegenInterval>600</RegenInterval>
                <RegenValue>5</RegenValue>
                <MinArmorPct>0.5</MinArmorPct>
              </li>
            </value>
          </nomatch>
        </li>
        <li Class="PatchOperationConditional">
          <xpath>Defs/ThingDef[defName="AEXP_WildGoose"]/modExtensions/li[@Class="CombatExtended.RacePropertiesExtensionCE"]</xpath>
          <match Class="PatchOperationSequence">
            <operations>
              <li Class="PatchOperationConditional">
                <xpath>Defs/ThingDef[defName="AEXP_WildGoose"]/modExtensions/li[@Class="CombatExtended.RacePropertiesExtensionCE"]/bodyShape</xpath>
                <match Class="PatchOperationReplace">
                  <xpath>Defs/ThingDef[defName="AEXP_WildGoose"]/modExtensions/li[@Class="CombatExtended.RacePropertiesExtensionCE"]/bodyShape</xpath>
                  <value>
                    <bodyShape>Birdlike</bodyShape>
                  </value>
                </match>
                <nomatch Class="PatchOperationAdd">
                  <xpath>Defs/ThingDef[defName="AEXP_WildGoose"]/modExtensions/li[@Class="CombatExtended.RacePropertiesExtensionCE"]</xpath>
                  <value>
                    <bodyShape>Birdlike</bodyShape>
                  </value>
                </nomatch>
              </li>
            </operations>
          </match>
          <nomatch Class="PatchOperationAddModExtension">
            <xpath>Defs/ThingDef[defName="AEXP_WildGoose"]</xpath>
            <value>
              <li Class="CombatExtended.RacePropertiesExtensionCE">
                <bodyShape>Birdlike</bodyShape>
              </li>
            </value>
          </nomatch>
        </li>
        <li Class="PatchOperationConditional">
          <xpath>/Defs/ThingDef[defName="AEXP_WildGoose"]/tools</xpath>
          <match Class="PatchOperationRemove">
            <xpath>/Defs/ThingDef[defName="AEXP_WildGoose"]/tools</xpath>
          </match>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="AEXP_WildGoose"]</xpath>
          <value>
            <tools>
              <li Class="CombatExtended.ToolCE">
                <label>head</label>
                <capacities>
                  <li>Blunt</li>
                </capacities>
                <power>0.2</power>
                <armorPenetrationBlunt>0.1</armorPenetrationBlunt>
                <cooldownTime>1.35</cooldownTime>
                <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
                <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
                <chanceFactor>0.2</chanceFactor>
              </li>
              <li Class="CombatExtended.ToolCE">
                <label>beak</label>
                <capacities>
                  <li>Blunt</li>
                </capacities>
                <power>1.5</power>
                <armorPenetrationBlunt>0.1</armorPenetrationBlunt>
                <armorPenetrationSharp>0.02</armorPenetrationSharp>
                <cooldownTime>1.85</cooldownTime>
                <linkedBodyPartsGroup>Beak</linkedBodyPartsGroup>
              </li>
            </tools>
          </value>
        </li>
        <li Class="PatchOperationConditional">
          <xpath>Defs/ThingDef[defName="AEXP_WildGoose"]/statBases/ArmorRating_Heat</xpath>
          <match Class="PatchOperationRemove">
            <xpath>Defs/ThingDef[defName="AEXP_WildGoose"]/statBases/ArmorRating_Heat</xpath>
          </match>
        </li>
      </operations>
    </match>
  </Operation>
</Patch>
