<?xml version='1.0' encoding='utf-8'?>
<Patch>
  <!---->
  <!-- AEXP_Camel -->
  <!-- AEXP_Camel StatBases -->
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "AEXP_Camel"]/statBases/MarketValue</xpath>
    <value>
      <MarketValue>500</MarketValue>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "AEXP_Camel"]/statBases/MoveSpeed</xpath>
    <value>
      <MoveSpeed>5</MoveSpeed>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "AEXP_Camel"]/statBases/Wildness</xpath>
    <value>
      <Wildness>0.3</Wildness>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "AEXP_Camel"]/statBases/FilthRate</xpath>
    <value>
      <FilthRate>15</FilthRate>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "AEXP_Camel"]/statBases/ComfyTemperatureMin</xpath>
    <value>
      <ComfyTemperatureMin>-50</ComfyTemperatureMin>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "AEXP_Camel"]/statBases/ComfyTemperatureMax</xpath>
    <value>
      <ComfyTemperatureMax>45</ComfyTemperatureMax>
    </value>
  </Operation>
  <!-- AEXP_Camel tools -->
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "AEXP_Camel"]/tools</xpath>
    <value>
      <tools>
        <li>
          <label>head</label>
          <capacities>
            <li>Blunt</li>
          </capacities>
          <power>17.5</power>
          <cooldownTime>2.95</cooldownTime>
          <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
          <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
          <chanceFactor>0.2</chanceFactor>
        </li>
        <li>
          <label>left hoof</label>
          <labelNoLocation>hoof</labelNoLocation>
          <capacities>
            <li>Blunt</li>
          </capacities>
          <power>21.5</power>
          <cooldownTime>2.8</cooldownTime>
          <linkedBodyPartsGroup>FrontLeftLeg</linkedBodyPartsGroup>
        </li>
        <li>
          <label>right hoof</label>
          <labelNoLocation>hoof</labelNoLocation>
          <capacities>
            <li>Blunt</li>
          </capacities>
          <power>21.5</power>
          <cooldownTime>2.8</cooldownTime>
          <linkedBodyPartsGroup>FrontRightLeg</linkedBodyPartsGroup>
        </li>
        <li>
          <label>teeth</label>
          <capacities>
            <li>Bite</li>
          </capacities>
          <power>23</power>
          <cooldownTime>2.95</cooldownTime>
          <linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
        </li>
      </tools>
    </value>
  </Operation>
  <!-- AEXP_Camel RaceProperties -->
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "AEXP_Camel"]/race/baseBodySize</xpath>
    <value>
      <baseBodySize>3</baseBodySize>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "AEXP_Camel"]/race/baseHealthScale</xpath>
    <value>
      <baseHealthScale>3</baseHealthScale>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "AEXP_Camel"]/race/baseHungerRate</xpath>
    <value>
      <baseHungerRate>1.15</baseHungerRate>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "AEXP_Camel"]/race/lifeExpectancy</xpath>
    <value>
      <lifeExpectancy>20</lifeExpectancy>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "AEXP_Camel"]/race/gestationPeriodDays</xpath>
    <value>
      <gestationPeriodDays>14</gestationPeriodDays>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "AEXP_Camel"]/race/roamMtbDays</xpath>
    <value>
      <roamMtbDays>8</roamMtbDays>
    </value>
  </Operation>
  <Operation Class="PatchOperationRemove">
    <xpath>/Defs/ThingDef[defName = "AEXP_Camel"]/race/wildBiomes</xpath>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "AEXP_Camel"]/race/lifeStageAges</xpath>
    <value>
      <lifeStageAges>
        <li>
          <def>AnimalBaby</def>
          <minAge>0</minAge>
        </li>
        <li>
          <def>AnimalJuvenile</def>
          <minAge>0.3</minAge>
        </li>
        <li>
          <def>AnimalAdult</def>
          <minAge>0.6</minAge>
          <soundWounded>Pawn_Dromedary_Wounded</soundWounded>
          <soundDeath>Pawn_Dromedary_Death</soundDeath>
          <soundCall>Pawn_Dromedary_Call</soundCall>
          <soundAngry>Pawn_Dromedary_Angry</soundAngry>
        </li>
      </lifeStageAges>
    </value>
  </Operation>
  <Operation Class="PatchOperationAddModExtension">
    <xpath>/Defs/ThingDef[defName = "AEXP_Camel"]</xpath>
    <value>
      <li Class="ZoologyMod.ModExtension_IsMammal, ZoologyMod"/>
    </value>
  </Operation>
  <Operation Class="PatchOperationAddModExtension">
    <xpath>/Defs/ThingDef[defName = "AEXP_Camel"]</xpath>
    <value>
      <li Class="ZoologyMod.ModExtensiom_Chlidcare, ZoologyMod"/>
    </value>
  </Operation>
  <!-- AEXP_Camel PawnKindDef -->
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/PawnKindDef[defName = "AEXP_Camel"]/combatPower</xpath>
    <value>
      <combatPower>205</combatPower>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/PawnKindDef[defName = "AEXP_Camel"]/ecoSystemWeight</xpath>
    <value>
      <ecoSystemWeight>1.5</ecoSystemWeight>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/PawnKindDef[defName = "AEXP_Camel"]</xpath>
    <value>
      <canArriveManhunter>false</canArriveManhunter>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/PawnKindDef[defName = "AEXP_Camel"]/wildGroupSize</xpath>
    <value>
      <wildGroupSize>3~10</wildGroupSize>
    </value>
  </Operation>
  <!-- Combat Extended specific patches -->
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Combat Extended</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
        <!-- AEXP_Camel CE patches -->
        <li Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="AEXP_Camel"]/statBases</xpath>
          <value>
            <MeleeDodgeChance>0.15</MeleeDodgeChance>
          </value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="AEXP_Camel"]/statBases</xpath>
          <value>
            <ArmorRating_Sharp>0.12</ArmorRating_Sharp>
          </value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="AEXP_Camel"]/statBases</xpath>
          <value>
            <ArmorRating_Blunt>0.5</ArmorRating_Blunt>
          </value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="AEXP_Camel"]/comps</xpath>
          <value>
            <li Class="CombatExtended.CompProperties_ArmorDurability">
              <Durability>1500</Durability>
              <Regenerates>true</Regenerates>
              <RegenInterval>600</RegenInterval>
              <RegenValue>5</RegenValue>
              <MinArmorPct>0.5</MinArmorPct>
            </li>
          </value>
        </li>
        <li Class="PatchOperationAddModExtension">
          <xpath>Defs/ThingDef[defName="AEXP_Camel"]</xpath>
          <value>
            <li Class="CombatExtended.RacePropertiesExtensionCE">
              <bodyShape>Quadruped</bodyShape>
            </li>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>/Defs/ThingDef[defName="AEXP_Camel"]/tools</xpath>
          <value>
            <tools>
              <li Class="CombatExtended.ToolCE">
                <label>head</label>
                <capacities>
                  <li>Blunt</li>
                </capacities>
                <power>15.6</power>
                <armorPenetrationBlunt>14.95</armorPenetrationBlunt>
                <cooldownTime>1.95</cooldownTime>
                <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
                <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
                <chanceFactor>0.2</chanceFactor>
              </li>
              <li Class="CombatExtended.ToolCE">
                <label>left hoof</label>
                <labelNoLocation>hoof</labelNoLocation>
                <capacities>
                  <li>Blunt</li>
                </capacities>
                <power>25</power>
                <armorPenetrationBlunt>16.95</armorPenetrationBlunt>
                <cooldownTime>2.7</cooldownTime>
                <linkedBodyPartsGroup>FrontLeftLeg</linkedBodyPartsGroup>
              </li>
              <li Class="CombatExtended.ToolCE">
                <label>right hoof</label>
                <labelNoLocation>hoof</labelNoLocation>
                <capacities>
                  <li>Blunt</li>
                </capacities>
                <power>25</power>
                <armorPenetrationBlunt>16.95</armorPenetrationBlunt>
                <cooldownTime>2.7</cooldownTime>
                <linkedBodyPartsGroup>FrontRightLeg</linkedBodyPartsGroup>
              </li>
              <li Class="CombatExtended.ToolCE">
                <label>teeth</label>
                <capacities>
                  <li>Bite</li>
                </capacities>
                <power>21.8</power>
                <armorPenetrationBlunt>10</armorPenetrationBlunt>
                <armorPenetrationSharp>0.11</armorPenetrationSharp>
                <cooldownTime>3.05</cooldownTime>
                <linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
              </li>
            </tools>
          </value>
        </li>
      </operations>
    </match>
  </Operation>
</Patch>
