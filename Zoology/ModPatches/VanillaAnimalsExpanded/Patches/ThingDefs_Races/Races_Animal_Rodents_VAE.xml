<?xml version='1.0' encoding='utf-8'?>
<Patch>
  <!---->
  <!-- AEXP_Beaver -->
  <!-- AEXP_Beaver StatBases -->
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "AEXP_Beaver"]/statBases/MarketValue</xpath>
    <value>
      <MarketValue>100</MarketValue>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "AEXP_Beaver"]/statBases/MoveSpeed</xpath>
    <value>
      <MoveSpeed>2</MoveSpeed>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "AEXP_Beaver"]/statBases/Wildness</xpath>
    <value>
      <Wildness>0.65</Wildness>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "AEXP_Beaver"]/statBases/FilthRate</xpath>
    <value>
      <FilthRate>1</FilthRate>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "AEXP_Beaver"]/statBases/ComfyTemperatureMin</xpath>
    <value>
      <ComfyTemperatureMin>-40</ComfyTemperatureMin>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThingDef[defName = "AEXP_Beaver"]/statBases</xpath>
    <value>
      <ComfyTemperatureMax>35</ComfyTemperatureMax>
    </value>
  </Operation>
  <!-- AEXP_Beaver tools -->
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "AEXP_Beaver"]/tools</xpath>
    <value>
      <tools>
        <li>
          <label>head</label>
          <capacities>
            <li>Blunt</li>
          </capacities>
          <power>5</power>
          <cooldownTime>1.7</cooldownTime>
          <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
          <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
          <chanceFactor>0.2</chanceFactor>
        </li>
        <li>
          <label>Incisors</label>
          <capacities>
            <li>Bite</li>
          </capacities>
          <power>8</power>
          <cooldownTime>1.6</cooldownTime>
          <linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
        </li>
      </tools>
    </value>
  </Operation>
  <!-- AEXP_Beaver RaceProperties -->
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "AEXP_Beaver"]/race/baseBodySize</xpath>
    <value>
      <baseBodySize>0.65</baseBodySize>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "AEXP_Beaver"]/race/baseHealthScale</xpath>
    <value>
      <baseHealthScale>0.65</baseHealthScale>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "AEXP_Beaver"]/race/baseHungerRate</xpath>
    <value>
      <baseHungerRate>0.45</baseHungerRate>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "AEXP_Beaver"]/race/lifeExpectancy</xpath>
    <value>
      <lifeExpectancy>12</lifeExpectancy>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "AEXP_Beaver"]/race/gestationPeriodDays</xpath>
    <value>
      <gestationPeriodDays>7.5</gestationPeriodDays>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThingDef[defName = "AEXP_Beaver"]/race</xpath>
    <value>
      <herdMigrationAllowed>false</herdMigrationAllowed>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "AEXP_Beaver"]/race/foodType</xpath>
    <value>
      <foodType>VegetarianRoughAnimal</foodType>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "AEXP_Beaver"]/race/manhunterOnTameFailChance</xpath>
    <value>
      <manhunterOnTameFailChance>0</manhunterOnTameFailChance>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "AEXP_Beaver"]/race/manhunterOnDamageChance</xpath>
    <value>
      <manhunterOnDamageChance>0</manhunterOnDamageChance>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThingDef[defName = "AEXP_Beaver"]/race</xpath>
    <value>
      <nuzzleMtbHours>48</nuzzleMtbHours>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThingDef[defName = "AEXP_Beaver"]/race</xpath>
    <value>
      <waterCellCost>1</waterCellCost>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThingDef[defName = "AEXP_Beaver"]/race</xpath>
    <value>
      <waterSeeker>true</waterSeeker>
    </value>
  </Operation>
  <Operation Class="PatchOperationRemove">
    <xpath>/Defs/ThingDef[defName = "AEXP_Beaver"]/race/wildBiomes</xpath>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "AEXP_Beaver"]/race/lifeStageAges</xpath>
    <value>
      <lifeStageAges>
        <li>
          <def>AnimalBaby</def>
          <minAge>0</minAge>
        </li>
        <li>
          <def>AnimalJuvenile</def>
          <minAge>0.15</minAge>
        </li>
        <li>
          <def>AnimalAdult</def>
          <minAge>0.3</minAge>
          <soundWounded>Pawn_Alphabeaver_Wounded</soundWounded>
          <soundDeath>Pawn_Alphabeaver_Death</soundDeath>
          <soundCall>Pawn_Alphabeaver_Call</soundCall>
          <soundAngry>Pawn_Alphabeaver_Angry</soundAngry>
        </li>
      </lifeStageAges>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName = "AEXP_Beaver"]/race/litterSizeCurve</xpath>
    <value>
      <litterSizeCurve>
        <points>
          <li>(0.6000, 0)</li>
          <li>(1.2000, 0.2)</li>
          <li>(2.4000, 1)</li>
          <li>(3.6000, 1)</li>
          <li>(4.8000, 0.2)</li>
          <li>(5.4000, 0)</li>
        </points>
      </litterSizeCurve>
    </value>
  </Operation>
  <Operation Class="PatchOperationRemove">
    <xpath>/Defs/ThingDef[defName = "AEXP_Beaver"]/tradeTags/li[text()='AnimalUncommon']</xpath>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThingDef[defName = "AEXP_Beaver"]/tradeTags</xpath>
    <value>
      <li>AnimalCommon</li>
    </value>
  </Operation>
  <Operation Class="PatchOperationAddModExtension">
    <xpath>/Defs/ThingDef[defName = "AEXP_Beaver"]</xpath>
    <value>
      <li Class="ZoologyMod.ModExtension_IsMammal, ZoologyMod"/>
    </value>
  </Operation>
  <Operation Class="PatchOperationAddModExtension">
    <xpath>/Defs/ThingDef[defName = "AEXP_Beaver"]</xpath>
    <value>
      <li Class="ZoologyMod.ModExtensiom_Chlidcare, ZoologyMod"/>
    </value>
  </Operation>
  <!-- AEXP_Beaver PawnKindDef -->
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/PawnKindDef[defName = "AEXP_Beaver"]/combatPower</xpath>
    <value>
      <combatPower>55</combatPower>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/PawnKindDef[defName = "AEXP_Beaver"]/ecoSystemWeight</xpath>
    <value>
      <ecoSystemWeight>0.5</ecoSystemWeight>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/PawnKindDef[defName = "AEXP_Beaver"]</xpath>
    <value>
      <canArriveManhunter>false</canArriveManhunter>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/PawnKindDef[defName = "AEXP_Beaver"]/wildGroupSize</xpath>
    <value>
      <wildGroupSize>3~8</wildGroupSize>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/PawnKindDef[defName = "AEXP_Beaver"]</xpath>
    <value>
      <moveSpeedFactorByTerrainTag/>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/PawnKindDef[defName = "AEXP_Beaver"]/moveSpeedFactorByTerrainTag</xpath>
    <value>
      <li>
        <key>Water</key>
        <value>1.4</value>
      </li>
    </value>
  </Operation>
  <!-- Combat Extended specific patches -->
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Combat Extended</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
        <!-- AEXP_Beaver CE patches -->
        <li Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="AEXP_Beaver"]/statBases</xpath>
          <value>
            <MeleeDodgeChance>0.4</MeleeDodgeChance>
          </value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="AEXP_Beaver"]/statBases</xpath>
          <value>
            <ArmorRating_Sharp>0.04</ArmorRating_Sharp>
          </value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="AEXP_Beaver"]/statBases</xpath>
          <value>
            <ArmorRating_Blunt>0.2</ArmorRating_Blunt>
          </value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="AEXP_Beaver"]/comps</xpath>
          <value>
            <li Class="CombatExtended.CompProperties_ArmorDurability">
              <Durability>325</Durability>
              <Regenerates>true</Regenerates>
              <RegenInterval>600</RegenInterval>
              <RegenValue>5</RegenValue>
              <MinArmorPct>0.5</MinArmorPct>
            </li>
          </value>
        </li>
        <li Class="PatchOperationAddModExtension">
          <xpath>Defs/ThingDef[defName="AEXP_Beaver"]</xpath>
          <value>
            <li Class="CombatExtended.RacePropertiesExtensionCE">
              <bodyShape>QuadrupedLow</bodyShape>
            </li>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>/Defs/ThingDef[defName="AEXP_Beaver"]/tools</xpath>
          <value>
            <tools>
              <li Class="CombatExtended.ToolCE">
                <label>head</label>
                <capacities>
                  <li>Blunt</li>
                </capacities>
                <power>0.9</power>
                <armorPenetrationBlunt>0.75</armorPenetrationBlunt>
                <cooldownTime>1.5</cooldownTime>
                <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
                <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
                <chanceFactor>0.2</chanceFactor>
              </li>
              <li Class="CombatExtended.ToolCE">
                <label>Incisors</label>
                <capacities>
                  <li>Bite</li>
                </capacities>
                <power>6.6</power>
                <armorPenetrationBlunt>1</armorPenetrationBlunt>
                <armorPenetrationSharp>0.1</armorPenetrationSharp>
                <cooldownTime>2.1</cooldownTime>
                <linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
              </li>
            </tools>
          </value>
        </li>
      </operations>
    </match>
  </Operation>
</Patch>
