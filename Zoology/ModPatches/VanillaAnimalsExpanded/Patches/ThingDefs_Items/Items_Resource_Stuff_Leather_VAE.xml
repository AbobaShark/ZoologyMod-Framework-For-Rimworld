<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!-- =======================================================================
		 Remove leathers
		 ======================================================================= -->
	
	<Operation Class="PatchOperationConditional">
      <xpath>/Defs/ThingDef[defName="AEXP_Leather_Wildebeest"]</xpath>
      <match Class="PatchOperationRemove">
        <xpath>/Defs/ThingDef[defName="AEXP_Leather_Wildebeest"]</xpath>
      </match>
    </Operation>
	
	<Operation Class="PatchOperationConditional">
      <xpath>/Defs/ThingDef[defName="AEXP_Leather_Platypus"]</xpath>
      <match Class="PatchOperationRemove">
        <xpath>/Defs/ThingDef[defName="AEXP_Leather_Platypus"]</xpath>
      </match>
    </Operation>
	
	<Operation Class="PatchOperationConditional">
      <xpath>/Defs/ThingDef[defName="AEXP_Leather_Lion"]</xpath>
      <match Class="PatchOperationRemove">
        <xpath>/Defs/ThingDef[defName="AEXP_Leather_Lion"]</xpath>
      </match>
    </Operation>
	
	
</Patch>
